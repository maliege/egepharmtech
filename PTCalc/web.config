<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS (Plesk/Natro) barındırma şablonu. dotnet publish bunu alır, %LAUNCHER_PATH% / %LAUNCHER_ARGS%
  yer tutucularını doldurur. Yayın framework-dependent ve UseAppHost=false olduğu için sonuç
  processPath="dotnet" arguments=".\PTCalc.dll" olur: barındırma .exe dosyasına izin vermez,
  ANCM in-process modda sunucudaki .NET 10 çalışma zamanını yükler.
  stdout günlüğü açık: uygulama başlamazsa ANCM logs\stdout_*.log dosyasına nedenini yazar (logs/ klasörünü
  deploy oluşturur ve aktarım dışında tutar). hostingModel in-process: aynı IIS havuzunda tek uygulama
  çalışır (ikincisi 500.35 verir); out-of-process bu sunucuda engellidir.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>

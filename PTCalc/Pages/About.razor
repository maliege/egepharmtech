@page "/about"
@using PTCalc.Site
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<SiteTitle Text="Hakkında" />
<section class="about-me" id="about" style="margin-top: 70px;">
    <div class="about-card">
        <div class="about-header">
            <i class="bi bi-info-circle about-icon"></i>
            <h2>@L["Hakkında"]</h2>
        </div>
        <div class="about-content">
            <p class="lead">
                @(IsEn ? L["EPT_Hakkinda_1"].Value : "PTCalc, farmasötik teknoloji için ücretsiz ve açık kaynak hesaplama araçlarının toplamıdır: dissolüsyon kinetiği, f1/f2 profil karşılaştırması, psödo-üçlü faz diyagramları, doz–yanıt analizi ve temel istatistik.")
            </p>
            <p>
                @(IsEn ? L["EPT_Hakkinda_2"].Value : "Araçları Ege Üniversitesi Eczacılık Fakültesi Farmasötik Teknoloji Anabilim Dalı öğretim görevlisi Dr. Mehmet Ali Ege yazdı. Çoğu, anabilim dalında 1995'ten bu yana kullanılan masaüstü programlarının devamıdır; psödo-üçlü faz diyagramı aracı 2001 tarihlidir. PTCalc adı \"Pharmaceutical Technology Calculators\" kısaltmasıdır; site üniversitenin resmi yayını değildir.")
            </p>
            <p>
                @(IsEn ? L["EPT_Hakkinda_3"].Value : "Kaynak kodu GitHub'da MIT lisansıyla yayımlanır; kinetik motorun sonuçları DDSolver 1.0 çıktılarıyla karşılaştırılmıştır. Araçları bir yayında kullanırsanız depodaki CITATION dosyasında açıklandığı gibi atıf yapın.")
            </p>
            <p>
                @(IsEn ? L["EPT_Hakkinda_4"].Value : "PTCalc, maege.tr'nin farmasötik teknoloji sürümüdür; maege.tr'de ayrıca yazarın amatör telsiz, astronomi ve botanik uygulamaları bulunur.")
            </p>
            <p class="mb-0">
                <a class="btn btn-outline-primary btn-sm me-2" href="https://maege.tr/about" rel="noopener">@L["Yazar hakkında"]</a>
                <a class="btn btn-outline-secondary btn-sm" href="https://github.com/maliege/ptcalc" target="_blank" rel="noopener"><i class="bi bi-github me-1"></i>@L["GitHub deposu"]</a>
            </p>
        </div>
    </div>
</section>

@code {
    [CascadingParameter] public SiteProfile Site { get; set; } = SiteProfiles.Tr;
    private static bool IsEn => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
}

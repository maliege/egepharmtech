@page "/anova"
<SiteTitle Text="Tek Yönlü ANOVA" />
@using PTCalc.Components.UI
@using PTCalc.Core.Services
@using PTCalc.Core.Statistics
@using PTCalc.Helpers
@using Microsoft.JSInterop
@inject AnalysisStateStatistics State
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<section class="container-fluid p-4">
    <ToastComponent @ref="_toast" />
    <h5 class="mb-3 text-primary fw-bold"><i class="bi bi-bar-chart-steps me-2"></i>@L["Tek Yönlü ANOVA"]</h5>

    <div class="row">
        <div class="col-lg-5 col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-table me-2"></i>@L["Veri Girişi"]</h5>
                </div>
                <div class="card-body p-2">
                    <HandsontableGrid @ref="_grid" Data="State.AnovaData" Columns="_columns" Height="380" MinRows="40"
                                      OnDataChanged="OnGridChanged" />
                    <small class="text-muted d-block mt-2 px-1">
                        @L["Her sütun bir gruptur; grupların gözlem sayısı farklı olabilir, boş hücreler atlanır. Boş sütunlar analize girmez."]
                    </small>
                    <div class="row g-2 mt-2 px-1">
                        @for (int i = 0; i < AnalysisStateStatistics.AnovaGroups; i++)
                        {
                            var idx = i;
                            <div class="col-4">
                                <input class="form-control form-control-sm" placeholder="@($"G{idx + 1}")"
                                       value="@State.AnovaGroupNames[idx]" @onchange="e => State.AnovaGroupNames[idx] = e.Value?.ToString() ?? string.Empty"
                                       aria-label="@L["Grup adı"]" />
                            </div>
                        }
                    </div>
                    <small class="text-muted d-block mt-1 px-1">@L["Grup adları (isteğe bağlı; tablo ve grafikte kullanılır)."]</small>
                </div>
            </div>
        </div>
        <div class="col-lg-7 col-md-6">
            <AnovaGuide />
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="mb-3">@L["Test Parametreleri"]</h5>
                    <div class="mb-2">
                        <label class="form-label"><strong>@L["Anlamlılık Düzeyi (α):"]</strong></label>
                        <select class="form-select w-auto" @bind="State.AnovaAlpha">
                            <option value="0.01">@L["0.01 (99% güven)"]</option>
                            <option value="0.05">@L["0.05 (95% güven)"]</option>
                            <option value="0.10">@L["0.10 (90% güven)"]</option>
                        </select>
                    </div>
                    <small class="text-muted">@L["Post-hoc karşılaştırma: Tukey HSD (eşit olmayan n'lerde Tukey-Kramer). Varyans homojenliği: Levene (ortalama merkezli)."]</small>
                </div>
                <div class="col-md-4 text-end">
                    <button class="btn btn-primary btn-lg" @onclick="ComputeAsync">
                        <i class="bi bi-play-fill me-2"></i>@L["Analizi Başlat"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_result is not null)
    {
        var r = _result;
        <div class="card shadow-sm mb-4">
            <div class="card-header @(r.Significant ? "bg-danger" : "bg-info") text-white">
                <h5 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>@L["Analiz Sonuçları"]</h5>
            </div>
            <div class="card-body">
                @if (r.Flags.Count > 0)
                {
                    <div class="alert alert-warning py-2">
                        <ul class="mb-0 small">
                            @foreach (var f in r.Flags) { <li>@f</li> }
                        </ul>
                    </div>
                }

                <div class="row">
                    <div class="col-lg-6">
                        <h6 class="text-primary mb-2">@L["Tanımlayıcı İstatistikler"]</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr><th>@L["Grup"]</th><th class="text-end">n</th><th class="text-end">@L["Ortalama"]</th><th class="text-end">SD</th><th class="text-end">SE</th><th class="text-end">Min</th><th class="text-end">Max</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in r.Groups)
                                    {
                                        <tr>
                                            <td>@g.Name</td><td class="text-end">@g.N</td>
                                            <td class="text-end">@g.Mean.ToString("F4")</td><td class="text-end">@g.Sd.ToString("F4")</td>
                                            <td class="text-end">@g.Se.ToString("F4")</td><td class="text-end">@g.Min.ToString("F4")</td><td class="text-end">@g.Max.ToString("F4")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div style="height: 260px;"><canvas id="@_chartId"></canvas></div>
                    </div>

                    <div class="col-lg-6">
                        <h6 class="text-primary mb-2">@L["ANOVA Tablosu"]</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr><th>@L["Kaynak"]</th><th class="text-end">SS</th><th class="text-end">df</th><th class="text-end">MS</th><th class="text-end">F</th><th class="text-end">p</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@L["Gruplar arası"]</td><td class="text-end">@r.SsBetween.ToString("F4")</td><td class="text-end">@r.DfBetween</td>
                                        <td class="text-end">@r.MsBetween.ToString("F4")</td><td class="text-end">@FormatF(r.F)</td><td class="text-end">@FormatP(r.P)</td>
                                    </tr>
                                    <tr>
                                        <td>@L["Grup içi (hata)"]</td><td class="text-end">@r.SsWithin.ToString("F4")</td><td class="text-end">@r.DfWithin</td>
                                        <td class="text-end">@r.MsWithin.ToString("F4")</td><td></td><td></td>
                                    </tr>
                                    <tr class="table-light">
                                        <td>@L["Toplam"]</td><td class="text-end">@r.SsTotal.ToString("F4")</td><td class="text-end">@(r.DfBetween + r.DfWithin)</td><td></td><td></td><td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr class="@(r.Significant ? "table-danger" : "table-success")">
                                    <td><strong>@L["Sonuç"]</strong></td>
                                    <td class="text-end">
                                        @if (r.Significant)
                                        {
                                            <span class="badge bg-danger">@L["En az bir grup ortalaması farklı (p < α)"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@L["Grup ortalamaları arasında anlamlı fark yok (p ≥ α)"]</span>
                                        }
                                    </td>
                                </tr>
                                <tr><td>@L["Etki büyüklüğü η² (eta kare)"]</td><td class="text-end">@r.Eta2.ToString("F4")</td></tr>
                                <tr><td>@L["Etki büyüklüğü ω² (omega kare)"]</td><td class="text-end">@r.Omega2.ToString("F4")</td></tr>
                                <tr>
                                    <td>@L["Levene varyans homojenliği"]</td>
                                    <td class="text-end">
                                        F = @FormatF(r.LeveneF), p = @FormatP(r.LeveneP)
                                        @if (r.LeveneP >= r.Alpha)
                                        {
                                            <span class="badge bg-success ms-2">@L["homojen"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark ms-2">@L["heterojen"]</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <small class="text-muted">
                            @L["η² örneklemde açıklanan varyans payıdır; ω² popülasyon için yansız tahmindir. Kabaca 0,01 küçük, 0,06 orta, 0,14 büyük etki."]
                        </small>
                    </div>
                </div>

                <hr />
                <h6 class="text-primary mb-2">@L["Tukey HSD ikili karşılaştırmalar"]</h6>
                @if (r.Tukey.Count == 0)
                {
                    <p class="text-muted small">@L["Grup içi varyans sıfır olduğundan Tukey HSD hesaplanamadı."]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["Karşılaştırma"]</th><th class="text-end">@L["Fark"]</th><th class="text-end">SE</th><th class="text-end">q</th>
                                    <th class="text-end">p (adj.)</th><th class="text-end">@L["Güven Aralığı"] (@Pct(r.Alpha))</th><th>@L["Sonuç"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in r.Tukey)
                                {
                                    <tr class="@(t.Significant ? "table-danger" : "")">
                                        <td>@t.A − @t.B</td><td class="text-end">@t.Diff.ToString("F4")</td><td class="text-end">@t.Se.ToString("F4")</td>
                                        <td class="text-end">@t.Q.ToString("F3")</td><td class="text-end">@FormatP(t.P)</td>
                                        <td class="text-end">[@t.Lower.ToString("F4"), @t.Upper.ToString("F4")]</td>
                                        <td>@(t.Significant ? L["anlamlı"] : L["anlamlı değil"])</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <small class="text-muted">
                        @L["q kritik"]: @r.QCritical.ToString("F3") (k = @r.Groups.Count, ν = @r.DfWithin, α = @r.Alpha.ToString("0.00")).
                        @L["Güven aralığı sıfırı içermiyorsa fark anlamlıdır; p-değerleri aile hatası için düzeltilmiştir."]
                    </small>
                }
            </div>
        </div>
    }
</section>

@code {
    private HandsontableGrid? _grid;
    private ToastComponent? _toast;
    private OneWayAnovaResult? _result;
    private bool _drawChart;
    private readonly string _chartId = $"anova-chart-{Guid.NewGuid():N}";
    private List<HandsontableGrid.ColumnConfig> _columns = [];

    protected override void OnInitialized()
    {
        _columns = Enumerable.Range(1, AnalysisStateStatistics.AnovaGroups)
            .Select(i => new HandsontableGrid.ColumnConfig { Title = $"G{i}", Data = $"g{i}", Type = "numeric", Width = 80, NumericFormat = "0.####" })
            .ToList();
    }

    // Hücre değişiklikleri devre durumuna yazılır: sayfadan çıkıp dönünce veri korunur.
    private Task OnGridChanged(List<object[]> changes)
    {
        GridJson.ApplyChanges(State.AnovaData, changes);
        return Task.CompletedTask;
    }

    private async Task ComputeAsync()
    {
        if (_grid is null) { _toast?.ShowFailed(L["Grid yüklenemedi."].Value); return; }
        var table = GridJson.ToTable(await _grid.GetDataAsync());
        var cols = StatisticsInputReader.ReadColumns(table, AnalysisStateStatistics.AnovaGroups);

        var groups = new List<IReadOnlyList<double>>();
        var names = new List<string>();
        for (int i = 0; i < cols.Count; i++)
        {
            if (cols[i].Count == 0) continue;
            groups.Add(cols[i]);
            names.Add(string.IsNullOrWhiteSpace(State.AnovaGroupNames[i]) ? $"G{i + 1}" : State.AnovaGroupNames[i]);
        }

        try
        {
            _result = OneWayAnova.Analyze(groups, names, State.AnovaAlpha);
            _drawChart = true;
            _toast?.ShowSuccess(L["Analiz tamamlandı."].Value);
        }
        catch (Exception ex)
        {
            _result = null;
            _toast?.ShowFailed($"{L["Hata:"].Value} {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_drawChart && _result is not null)
        {
            _drawChart = false;
            await DrawChartAsync(_result);
        }
    }

    private async Task DrawChartAsync(OneWayAnovaResult r)
    {
        // Ortalama ± SD: Chart.js 2.9'da hata çubuğu yok; ortalama sütun, SD alt/üst ayrı çizgi noktası olarak gösterilir.
        var labels = r.Groups.Select(g => g.Name).ToArray();
        var config = new
        {
            type = "bar",
            data = new
            {
                labels,
                datasets = new object[]
                {
                    new { label = L["Ortalama"].Value, data = r.Groups.Select(g => g.Mean).ToArray(), backgroundColor = "rgba(13, 148, 136, 0.55)", borderColor = "rgba(13, 148, 136, 1)", borderWidth = 1 },
                    new { label = L["Ortalama + SD"].Value, data = r.Groups.Select(g => g.Mean + g.Sd).ToArray(), type = "line", fill = false, showLine = false, pointStyle = "line", pointRadius = 8, borderColor = "rgba(30, 41, 59, 0.9)", backgroundColor = "rgba(30, 41, 59, 0.9)" },
                    new { label = L["Ortalama − SD"].Value, data = r.Groups.Select(g => g.Mean - g.Sd).ToArray(), type = "line", fill = false, showLine = false, pointStyle = "line", pointRadius = 8, borderColor = "rgba(30, 41, 59, 0.9)", backgroundColor = "rgba(30, 41, 59, 0.9)" }
                }
            },
            options = new
            {
                responsive = true, maintainAspectRatio = false,
                legend = new { display = true, position = "bottom" },
                scales = new
                {
                    yAxes = new[] { new { scaleLabel = new { display = true, labelString = L["Grup ortalaması"].Value } } }
                }
            }
        };
        try { await JS.InvokeVoidAsync("chartInterop.renderChart", _chartId, config); }
        catch (Exception ex) { Console.WriteLine($"Chart error: {ex.Message}"); }
    }

    private static string FormatF(double f) => double.IsNaN(f) ? "-" : double.IsInfinity(f) ? "∞" : f.ToString("F4");
    private static string Pct(double alpha) => Lang.IsEn ? $"{(1 - alpha) * 100:0.#}%" : $"%{(1 - alpha) * 100:0.#}";
    private static string FormatP(double p) => double.IsNaN(p) ? "-" : p < 0.0001 ? "< " + (0.0001).ToString("0.0000") : p.ToString("F4");
}

    private async Task CalculateDiagram()
    {
        if (inputGrid is null) { statusMessage = $"<i class='bi bi-exclamation-circle-fill'></i> {T("Grid yüklenemedi.")}"; return; }
        statusMessage = $"<i class='bi bi-hourglass-split'></i> {T("Hesaplanıyor...")}"; StateHasChanged();

        var gridData = await inputGrid.GetDataAsync();
        if (gridData is null) { statusMessage = $"<i class='bi bi-exclamation-circle-fill'></i> {T("Veri alınamadı.")}"; return; }

        lastRows = RowsFromGrid(gridData);
        groupIdToName.Clear();
        groupNameToId.Clear();

        var dataList = ConvertGridData(gridData);
        if (dataList.Count == 0) { statusMessage = $"<i class='bi bi-exclamation-circle-fill'></i> {T("Geçerli veri yok.")}"; return; }
        totalWarnings = TernaryTotals.Check(dataList);

        var request = new DiagramCalculationRequest
        {
            Data = dataList,
            Configuration = new ChartConfiguration { PolygonCloseType = polygonCloseType, PolygonCloseEdge = edgeType }
        };

        var response = calculationService.Calculate(request);
        if (response.Success)
        {
            resultGroups = response.Groups;

            // Sonuç listesindeki grup numaralarını isimleriyle eşleştir (UI için)
            foreach (var g in resultGroups)
            {
                if (groupIdToName.TryGetValue(g.N, out var name))
                {
                    g.GrupAdi = name;
                }
            }
            calculatedData = dataList;
            foreach (var item in calculatedData)
            {
                if (item.p != null)
                {
                    var oil = item.oil / 100.0;
                    var surf = item.surCoSur / 100.0;
                    item.p.X = surf + oil * Cos60;
                    item.p.Y = oil * Sin60;
                }
            }
            calculatedPolygons = CalculatePolygonPoints(calculatedData, polygonCloseType, edgeType);
            foreach (var group in resultGroups)
                UpdateGroupMetrics(group);

            // Seçili grup artık yoksa seçimi bırak
            if (selectedGroup is int s && !GroupExists(s)) selectedGroup = null;

            statusMessage = $"<i class='bi bi-check-circle-fill'></i> {response.Message}";
        }
        else { statusMessage = $"<i class='bi bi-x-circle-fill'></i> {response.Message}"; }

        await AutosaveAsync();
    }

    private Dictionary<int, List<PointD>> CalculatePolygonPoints(List<Ttridata> data, int closeType, int edge)
    {
        var result = new Dictionary<int, List<PointD>>();
        polygonClosings.Clear();
        smallGroups.Clear();
        var groupNumbers = data.Select(d => d.grup).Distinct().OrderBy(g => g).ToList();
        foreach (var groupNum in groupNumbers)
        {
            var groupData = data.Where(d => d.grup == groupNum).OrderBy(d => d.siraNo).ToList();
            var polygon = new List<PointD>();
            foreach (var item in groupData)
            {
                if (item.p != null)
                    polygon.Add(new PointD { X = item.p.X, Y = item.p.Y });
            }
            // 1–2 nokta: bölge değil, nokta/çizgi. Kapatma noktası eklenmez, sıralamaya girmez.
            if (polygon.Count < 3)
            {
                if (polygon.Count > 0) smallGroups[groupNum] = polygon;
                continue;
            }
            PointD? closingStart = null, closingEnd = null, closingLineA = null, closingLineB = null;
            if (closeType == 0) { }
            else if (closeType >= 1)
            {
                var closingPoints = CalculateClosingPoints(groupData, closeType, edge);
                if (closingPoints.start != null && closingPoints.end != null)
                {
                    polygon.Insert(0, closingPoints.start);
                    polygon.Add(closingPoints.end);
                    closingStart = closingPoints.start;
                    closingEnd = closingPoints.end;
                    closingLineA = closingPoints.lineA;
                    closingLineB = closingPoints.lineB;
                }
            }
            result[groupNum] = polygon;
            polygonClosings[groupNum] = (closingStart, closingEnd, closingLineA, closingLineB);
        }
        return result;
    }

    private (PointD? start, PointD? end, PointD? lineA, PointD? lineB) CalculateClosingPoints(List<Ttridata> groupData, int closeType, int edge)
    {
        if (groupData.Count < 2) return (null, null, null, null);
        var c1 = new LineD { U1 = new PointD(), U2 = new PointD() };
        var c2 = new LineD { U1 = new PointD(), U2 = new PointD() };
        if (closeType == 1)
        {
            double minValue;
            switch (edge)
            {
                case 0:
                    minValue = groupData.Min(d => d.oil) / 100.0;
                    c1.U1 = calculationService.Abc2Xy(0, minValue, 21);
                    c1.U2 = calculationService.Abc2Xy(0, minValue, 31);
                    break;
                case 1:
                    minValue = groupData.Min(d => d.surCoSur) / 100.0;
                    c1.U1 = calculationService.Abc2Xy(minValue, 0, 21);
                    c1.U2 = calculationService.Abc2Xy(0, minValue, 32);
                    break;
                case 2:
                    minValue = groupData.Min(d => d.water) / 100.0;
                    c1.U1 = calculationService.Abc2Xy(minValue, 0, 31);
                    c1.U2 = calculationService.Abc2Xy(minValue, 0, 32);
                    break;
            }
        }
        else if (closeType == 2)
        {
            switch (edge)
            {
                case 0:
                    c1.U1 = calculationService.Abc2Xy(0, 0, 21);
                    c1.U2 = calculationService.Abc2Xy(0, 0, 31);
                    break;
                case 1:
                    c1.U1 = calculationService.Abc2Xy(0, 0, 32);
                    c1.U2 = calculationService.Abc2Xy(0, 0, 21);
                    break;
                case 2:
                    c1.U1 = calculationService.Abc2Xy(0, 0, 31);
                    c1.U2 = calculationService.Abc2Xy(0, 0, 32);
                    break;
            }
        }
        switch (edge)
        {
            case 0: c2.U1 = new PointD { X = 0.5, Y = Sin60 }; break;
            case 1: c2.U1 = new PointD { X = 1, Y = 0 }; break;
            case 2: c2.U1 = new PointD { X = 0, Y = 0 }; break;
        }
        PointD? startPoint = null;
        if (groupData[0].p != null)
        {
            c2.U2 = groupData[0].p;
            startPoint = calculationService.IntersectionPoint(c1, c2);
        }
        PointD? endPoint = null;
        if (groupData[^1].p != null)
        {
            c2.U2 = groupData[^1].p;
            endPoint = calculationService.IntersectionPoint(c1, c2);
        }
        return (startPoint, endPoint, c1.U1, c1.U2);
    }

    private List<Ttridata> ConvertGridData(object gridData)
    {
        var result = new List<Ttridata>();
        if (gridData is not JsonElement json || json.ValueKind != JsonValueKind.Array) return result;
        foreach (var row in json.EnumerateArray())
        {
            if (row.ValueKind != JsonValueKind.Array) continue;
            var cells = row.EnumerateArray().ToList();
            if (cells.Count < 5 || cells[0].ValueKind == JsonValueKind.Null) continue;
            var item = new Ttridata();
            if (!TryGetString(cells[0], out var gName)) continue;
            item.grup = GetOrCreateGroupId(gName);
            TryGetInt(cells[1], out var s); item.siraNo = s;
            if (!TryGetDouble(cells[2], out var o)) continue; item.oil = o;
            if (!TryGetDouble(cells[3], out var sc)) continue; item.surCoSur = sc;
            if (!TryGetDouble(cells[4], out var w)) continue; item.water = w;
            result.Add(item);
        }
        return result;
    }

    private (PointD centroid, double area) CalculatePolygonCentroidAndArea(List<PointD> polygon)
    {
        if (polygon.Count < 3)
            return (new PointD { X = 0, Y = 0 }, 0);
        double aSum = 0;
        double xSum = 0;
        double ySum = 0;
        for (int i = 0; i < polygon.Count; i++)
        {
            int j = (i + 1) % polygon.Count;
            double term = (polygon[i].X * polygon[j].Y) - (polygon[j].X * polygon[i].Y);
            aSum += term;
            xSum += (polygon[j].X + polygon[i].X) * term;
            ySum += (polygon[j].Y + polygon[i].Y) * term;
        }
        double area = 0.5 * Math.Abs(aSum);
        if (Math.Abs(aSum) < 1e-10)
            return (new PointD { X = 0, Y = 0 }, area);
        var centroid = new PointD
        {
            X = xSum / (3.0 * aSum),
            Y = ySum / (3.0 * aSum)
        };
        return (centroid, area);
    }

    private bool TryGetInt(JsonElement e, out int v)
    {
        v = 0;
        if (e.ValueKind == JsonValueKind.Number) { v = (int)Math.Round(e.GetDouble()); return true; }
        return e.ValueKind == JsonValueKind.String && int.TryParse(e.GetString(), out v);
    }
    // Metin değerler için ayrıştırma NumericCellParser'a devredildi: eskiden
    // kültür belirtilmediği için makinenin bölge ayarına göre "3.5" tr-TR'de 35
    // olarak okunabiliyordu.
    private bool TryGetDouble(JsonElement e, out double v) { v = 0; if (e.ValueKind == JsonValueKind.Number) { v = e.GetDouble(); return true; } return e.ValueKind == JsonValueKind.String && NumericCellParser.TryParse(e.GetString(), out v); }
    private bool TryGetString(JsonElement e, out string v)
    {
        v = string.Empty;
        if (e.ValueKind == JsonValueKind.String)
        {
            v = e.GetString() ?? string.Empty;
            return true;
        }
        if (e.ValueKind == JsonValueKind.Number)
        {
            v = e.GetRawText();
            return true;
        }
        return false;
    }

    protected override void OnInitialized()
    {
        statusMessage = $"<i class='bi bi-info-circle-fill'></i> {T("Veri yükleyin ve hesapla butonuna tıklayın.")}";
        autosaveNote = T("Bu tarayıcıda otomatik kaydedilir.");

        // Sütun başlıkları arayüz dilinden; Data anahtarları (grup, siraNo, ...) belge biçiminin parçasıdır, değişmez.
        inputColumns = [
            new() { Data = "grup", Title = T("Grup"), Width = 120, Type = "text" },
            new() { Data = "siraNo", Title = T("Sıra"), Width = 60, Type = "numeric" },
            new() { Data = "oil", Title = "Oil", Width = 70, Type = "numeric", NumericFormat = "0.00" },
            new() { Data = "surCoSur", Title = "Sur/CoSur", Width = 90, Type = "numeric", NumericFormat = "0.00" },
            new() { Data = "water", Title = "Water", Width = 70, Type = "numeric", NumericFormat = "0.00" }
        ];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Task.Delay(100);
        isLoaded = true;
        StateHasChanged();

        // Bu tarayıcıda kayıtlı çalışma varsa geri yükle. Grid kendi OnAfterRender'ında
        // kuruluyor; hazır olana kadar (en fazla ~3 s) bekle.
        string? json = null;
        try { json = await JS.InvokeAsync<string?>("ternaryStore.load", LocalStorageKey); } catch (JSException) { }
        if (string.IsNullOrWhiteSpace(json)) return;

        var doc = TernaryDocument.FromJson(json);
        if (doc is null) return;

        for (int i = 0; i < 20 && (inputGrid is null || await inputGrid.GetDataAsync() is null); i++)
            await Task.Delay(150);
        if (inputGrid is null) return;

        await RestoreDocumentAsync(doc);
        hasLocalCopy = true;
        autosaveNote = T("Bu tarayıcıdaki kayıt geri yüklendi ({0}).", doc.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"));
        if (doc.Rows.Count > 0)
            statusMessage = $"<i class='bi bi-check-circle-fill'></i> {T("Son çalışmanız geri yüklendi ({0} satır).", doc.Rows.Count)}";
        StateHasChanged();
    }

    private async Task LoadSampleData()
    {
        if (string.IsNullOrEmpty(selectedSample) || inputGrid is null) return;
        var data = GetSampleData(selectedSample);

        // Gridde Grup alanı string de alabiliyor (deney adı gibi).
        // Örnek veriyi de kullanıcıya bunu gösterecek şekilde string'e çevirerek basıyoruz.
        var gridData = data.Select(d => new
        {
            grup = $"Deney {d.grup}",
            siraNo = d.siraNo,
            oil = d.oil,
            surCoSur = d.surCoSur,
            water = d.water
        }).ToList();

        await inputGrid.UpdateDataAsync(gridData);
        lastRows = RowsFromGrid(await inputGrid.GetDataAsync());
        statusMessage = $"<i class='bi bi-check-circle-fill'></i> {T("{0} satır yüklendi.", data.Count)}";
        await AutosaveAsync();
    }


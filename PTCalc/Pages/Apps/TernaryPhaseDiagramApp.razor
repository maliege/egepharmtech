@page "/ternary-phase-diagram-app"
<SiteTitle Text="Üçgen Faz Diyagramı" />
@using System.Globalization
@using PTCalc.Core.Helpers
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Rendering
@using PTCalc.Core.Models
@using PTCalc.Core.Services
@using PTCalc.Middleware
@using PTCalc.Components.UI
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L


<section id="ternary-container" class="container-fluid p-4">

    <h1>@L["Üçgen Faz Diyagramı"]</h1>

    <div class="row g-3 flex-lg-nowrap align-items-start">
        <div class="col-12 col-lg-4 tab-column">

            <div class="tabs-container">
                <ul class="nav nav-pills custom-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="input-tab" data-bs-toggle="tab" data-bs-target="#input-pane" type="button" role="tab">
                            <i class="bi bi-table me-1"></i> @L["Veri Girişi"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="diagram-tab" data-bs-toggle="tab" data-bs-target="#diagram-settings" type="button" role="tab">
                            <i class="bi bi-sliders me-1"></i> @L["Diyagram"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="chart-tab" data-bs-toggle="tab" data-bs-target="#chart-settings" type="button" role="tab">
                            <i class="bi bi-gear me-1"></i> @L["Grafik"]
                        </button>
                    </li>
                </ul>

                <div class="tab-content tab-content-box">
                    <div class="tab-pane fade show active" id="input-pane" role="tabpanel" aria-labelledby="input-tab">
                        @if (isLoaded)
                        {
                            <HandsontableGrid @ref="inputGrid" Columns="@inputColumns" Height="420" MinRows="250" OnDataChanged="OnGridChangedAsync" />
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-sm btn-outline-success" @onclick="AddRow"><i class="bi bi-plus-lg"></i> @L["Satır Ekle"]</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteRow"><i class="bi bi-trash"></i> @L["Satır Sil"]</button>
                                <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="ClearGrid"><i class="bi bi-eraser"></i> @L["Temizle"]</button>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5"><div class="spinner-border"></div></div>
                        }

                        <button class="btn btn-primary w-100 mt-2" @onclick="CalculateDiagram"><i class="bi bi-calculator"></i> @L["Hesapla"]</button>

                        <div class="mb-3">
                            <label class="form-label">@L["Örnek Veri"]</label>
                            <select class="form-select" @bind="selectedSample" @bind:after="LoadSampleData">
                                <option value="">@L["-- Seçin --"]</option>
                                <option value="Ornek 1">@L["Örnek"] 1</option>
                                <option value="Ornek 2">@L["Örnek"] 2</option>
                                <option value="Ornek 3">@L["Örnek"] 3</option>
                                <option value="Ornek 4">@L["Örnek"] 4</option>
                            </select>
                        </div>

                        <hr />
                        @* Kaydet / aç. A: bu tarayıcıda otomatik (localStorage). B: .json dosyası. *@
                        <label class="form-label">@L["Çalışmayı sakla"]</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="SaveToFileAsync" title="@L["Veri, ayarlar ve grup stilleri tek .json dosyasında"]">
                                <i class="bi bi-file-earmark-arrow-down"></i> @L["Dosyaya kaydet"]
                            </button>
                            <label class="btn btn-sm btn-outline-secondary mb-0" title="@L["Daha önce kaydedilmiş .json dosyasını yükle"]">
                                <i class="bi bi-folder2-open"></i> @L["Dosyadan aç"]
                                <InputFile OnChange="OpenFromFileAsync" accept=".json,application/json" class="d-none" />
                            </label>
                        </div>
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-clock-history me-1"></i>@autosaveNote
                            @if (hasLocalCopy)
                            {
                                <text> · </text><a href="javascript:void(0)" @onclick="ForgetLocalAsync" @onclick:preventDefault>@L["bu tarayıcıdaki kopyayı sil"]</a>
                            }
                        </small>

                    </div>

                    <div class="tab-pane fade" id="diagram-settings" role="tabpanel" aria-labelledby="diagram-tab">
                        <div class="mb-3">
                            <label class="form-label">@L["Başlık"]</label>
                            <input type="text" class="form-control" @bind="chartTitle" @bind:after="AutosaveAsync" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Oil</label>
                            <input type="text" class="form-control" @bind="titleOil" @bind:after="AutosaveAsync" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Surfactant</label>
                            <input type="text" class="form-control" @bind="titleSurfactant" @bind:after="AutosaveAsync" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Water</label>
                            <input type="text" class="form-control" @bind="titleWater" @bind:after="AutosaveAsync" />
                        </div>
                        <hr />

                    </div>

                    <div class="tab-pane fade" id="chart-settings" role="tabpanel" aria-labelledby="chart-tab">
                        <div class="mb-3">
                            <label class="form-label">@L["Eksen Aralığı"]</label>
                            <select class="form-select" @bind="axisInterval" @bind:after="AutosaveAsync">
                                <option value="5">@L["5 birim (0, 5, 10, ...)"]</option>
                                <option value="10">@L["10 birim (0, 10, 20, ...)"]</option>
                                <option value="20">@L["20 birim (0, 20, 40, ...)"]</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["Polygon Kapatma"]</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="polygonClose" id="polygonClose0"
                                       value="0" @onchange="@(() => OnPolygonCloseTypeChanged(0))"
                                       @attributes="@(polygonCloseType == 0 ? new Dictionary<string, object> { ["checked"] = true } : new())" />
                                <label class="form-check-label" for="polygonClose0">@L["Poligonu Kapat"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="polygonClose" id="polygonClose1"
                                       value="1" @onchange="@(() => OnPolygonCloseTypeChanged(1))"
                                       @attributes="@(polygonCloseType == 1 ? new Dictionary<string, object> { ["checked"] = true } : new())" />
                                <label class="form-check-label" for="polygonClose1">@L["Min Değer Kapatma"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="polygonClose" id="polygonClose2"
                                       value="2" @onchange="@(() => OnPolygonCloseTypeChanged(2))"
                                       @attributes="@(polygonCloseType == 2 ? new Dictionary<string, object> { ["checked"] = true } : new())" />
                                <label class="form-check-label" for="polygonClose2">@L["Kenar Kapatma"]</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["Kapatma Kenarı"]</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="edgeType" id="edgeType0"
                                       value="0" @onchange="@(() => OnEdgeTypeChanged(0))"
                                       @attributes="@(edgeType == 0 ? new Dictionary<string, object> { ["checked"] = true } : new())" />
                                <label class="form-check-label" for="edgeType0">Oil</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="edgeType" id="edgeType1"
                                       value="1" @onchange="@(() => OnEdgeTypeChanged(1))"
                                       @attributes="@(edgeType == 1 ? new Dictionary<string, object> { ["checked"] = true } : new())" />
                                <label class="form-check-label" for="edgeType1">Surfactant</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="edgeType" id="edgeType2"
                                       value="2" @onchange="@(() => OnEdgeTypeChanged(2))"
                                       @attributes="@(edgeType == 2 ? new Dictionary<string, object> { ["checked"] = true } : new())" />
                                <label class="form-check-label" for="edgeType2">Water</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="smoothEdges"
                                       checked="@smoothEdges" @onchange="OnSmoothEdgesChanged" />
                                <label class="form-check-label" for="smoothEdges">@L["Kenarları yumuşat (Bezier)"]</label>
                            </div>
                            @if (smoothEdges)
                            {
                                <label class="form-label mt-2">@L["Yumuşatma"]: @smoothTension% <span class="text-muted">@L["(%60 ≈ klasik Catmull-Rom)"]</span></label>
                                <input type="range" class="form-range" min="0" max="100" step="5"
                                       value="@smoothTension" @oninput="OnSmoothTensionChanged" />
                                <small class="text-muted d-block">
                                    @L["Eğri ölçüm noktalarından geçer; kenar üzerindeki kapatma noktalarına düz çizgiyle bağlanır. Alan ve merkez, yumuşatılmış çerçeveden hesaplanır. İki ölçüm arasındaki gerçek sınır bilinmediği için bu bir görsel yorumdur."]
                                </small>
                            }
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="gradientFill"
                                       @bind="showGradientFill" @bind:after="AutosaveAsync" />
                                <label class="form-check-label" for="gradientFill">@L["Gradient dolgu göster"]</label>
                            </div>

                            <label class="form-label">@L["Gradient Opaklık"]: @gradientOpacity%</label>
                            <input type="range" class="form-range" min="10" max="100"
                                   value="@gradientOpacity" @oninput="OnGradientOpacityChanged" />
                        </div>


                        <div class="mb-3">
                            <label class="form-label">@L["Poligon kenar opaklığı"]: @((int)Math.Round(borderAlpha / 255.0 * 100))%</label>
                            <input type="range" class="form-range" min="10" max="255"
                                   value="@borderAlpha" @oninput="OnBorderAlphaChanged" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["Poligon dolgu opaklığı"]: @((int)Math.Round(fillAlpha / 255.0 * 100))%</label>
                            <input type="range" class="form-range" min="10" max="255"
                                   value="@fillAlpha" @oninput="OnFillAlphaChanged" />
                        </div>
                        <small class="text-muted d-block">
                            @L["Bu iki kaydırıcı bütün gruplar için varsayılandır. Bir gruba diyagramda tıklayıp kendi rengini ve opaklığını verebilirsiniz; grup değeri varsayılanı ezer."]
                        </small>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8 pe-lg-4">
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h5 class="mb-0">@L["Ternary Diyagram"]</h5>
                    <a class="btn btn-sm btn-outline-secondary ms-auto" href="/about-ternary-phase-diagram" title="@L["Kullanım kılavuzu ve kuramsal arka plan"]">
                <i class="bi bi-book"></i> @L["Rehber"]
            </a>
            <button class="btn btn-sm btn-outline-primary ms-2" @onclick="DownloadSvgAsync" title="@L["Diyagramı SVG dosyası olarak indir"]">
                        <i class="bi bi-download"></i> @L["SVG indir"]
                    </button>
                </div>
                <div class="card-body">
                    @RenderSvgMarkup()

                    @if (selectedGroup is int sel && GroupExists(sel))
                    {
                        var st = StyleFor(sel);
                        var name = GroupNameOf(sel);
                        var custom = groupStyles.TryGetValue(name, out var cs) ? cs : null;
                        <div class="group-style-panel mt-3">
                            <div class="d-flex align-items-center mb-2">
                                <span class="swatch me-2" style="background:@st.Fill; border-color:@st.Stroke;"></span>
                                <strong>@name</strong>
                                <span class="text-muted small ms-2">@L["seçili grup"]</span>
                                <button class="btn btn-sm btn-link ms-auto p-0" @onclick="ClearSelection">@L["Seçimi kaldır"]</button>
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-6 col-md-3">
                                    <label class="form-label small mb-1">@L["Dolgu rengi"]</label>
                                    <input type="color" class="form-control form-control-color w-100" value="@st.Fill"
                                           @oninput="@(e => UpdateStyleAsync(sel, s => s.Fill = e.Value?.ToString()))" />
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label small mb-1">@L["Kenar rengi"]</label>
                                    <input type="color" class="form-control form-control-color w-100" value="@st.Stroke"
                                           @oninput="@(e => UpdateStyleAsync(sel, s => s.Stroke = e.Value?.ToString()))" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small mb-1">@L["Dolgu opaklığı"]: @Pct(st.FillOpacity)%</label>
                                    <input type="range" class="form-range" min="0" max="255"
                                           value="@((int)Math.Round(st.FillOpacity * 255))"
                                           @oninput="@(e => UpdateStyleAsync(sel, s => s.FillAlpha = ParseInt(e.Value)))" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small mb-1">@L["Kenar opaklığı"]: @Pct(st.StrokeOpacity)%</label>
                                    <input type="range" class="form-range" min="0" max="255"
                                           value="@((int)Math.Round(st.StrokeOpacity * 255))"
                                           @oninput="@(e => UpdateStyleAsync(sel, s => s.StrokeAlpha = ParseInt(e.Value)))" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label small mb-1">@L["Kenar kalınlığı"]: @F(st.StrokeWidth)</label>
                                    <input type="range" class="form-range" min="0" max="8" step="0.5"
                                           value="@F(st.StrokeWidth)"
                                           @oninput="@(e => UpdateStyleAsync(sel, s => s.StrokeWidth = ParseDouble(e.Value)))" />
                                </div>
                            </div>
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ResetStyleAsync(sel)" disabled="@(custom is null)">
                                    <i class="bi bi-arrow-counterclockwise"></i> @L["Varsayılana dön"]
                                </button>
                                <small class="text-muted ms-2">@L["Stil grup adına bağlıdır; aynı adlı grup sonraki çalışmalarda da bu rengi alır."]</small>
                            </div>
                        </div>
                    }

                    <div class="mt-3">
                        <div class="alert @GetStatusClass() mb-0"><small>@((MarkupString)statusMessage)</small></div>
                        @if (totalWarnings.Count > 0)
                        {
                            <div class="alert alert-warning mt-2 mb-0" role="alert">
                                <small>
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <strong>@L["{0} satırda yağ + sürfaktan + su toplamı 100 değil", totalWarnings.Count]</strong>
                                    @L["(tolerans ±{0}). Nokta yağ ve sürfaktan yüzdesinden yerleştirilir, su kalan olarak okunur; bu satırlar girilen suya göre yanlış yerde durur. Düzeltip yeniden hesaplayın.", TernaryTotals.DefaultTolerance.ToString("0.#")]
                                    <ul class="mb-0 mt-1">
                                        @foreach (var d in totalWarnings.Take(8))
                                        {
                                            <li>@L["{0} · sıra {1}: toplam {2} ({3})", GroupName(d.Group), d.Order, d.Total.ToString("0.##"), (d.Delta > 0 ? "+" : "") + d.Delta.ToString("0.##")]</li>
                                        }
                                        @if (totalWarnings.Count > 8)
                                        {
                                            <li>@L["… ve {0} satır daha", totalWarnings.Count - 8]</li>
                                        }
                                    </ul>
                                </small>
                            </div>
                        }
                    </div>
                    @if (resultGroups.Count > 0)
                    {
                        <div class="mt-3">
                            <table class="table table-sm table-bordered group-table">
                                <thead><tr><th></th><th>@L["Grup"]</th><th class="text-end">Oil</th><th class="text-end">Surf</th><th class="text-end">Water</th><th class="text-end">@L["Alan"]</th></tr></thead>
                                <tbody>
                                    @foreach (var g in resultGroups)
                                    {
                                        var gs = StyleFor(g.N);
                                        <tr class="@(selectedGroup == g.N ? "table-primary" : "")" @onclick="() => SelectGroup(g.N)" title="@L["Seçmek için tıklayın"]">
                                            <td style="width:28px;"><span class="swatch" style="background:@gs.Fill; border-color:@gs.Stroke;"></span></td>
                                            <td>@(g.GrupAdi ?? g.N.ToString())</td>
                                            <td class="text-end">@g.A.ToString("F2")</td>
                                            <td class="text-end">@g.B.ToString("F2")</td>
                                            <td class="text-end">@g.C.ToString("F2")</td>
                                            <td class="text-end">@g.Area.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</section>
<style>
    #ternary-container {
        background-color: var(--bg-primary);
        color: var(--text-primary);
    }

    .tab-column {
        min-width: 320px;
    }

    .tabs-container {
        background: var(--gradient-card);
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: var(--shadow-md);
    }

    .custom-tabs {
        background: var(--bg-hover);
        border-radius: 12px;
        padding: 6px;
        gap: 4px;
        margin-bottom: 1rem;
    }

        .custom-tabs .nav-item {
            flex: 1;
        }

        .custom-tabs .nav-link {
            width: 100%;
            color: var(--text-muted);
            background: transparent;
            border: none;
            border-radius: 8px;
            padding: 0.65rem 0.5rem;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .custom-tabs .nav-link:hover {
                color: var(--text-primary);
                background: var(--bg-hover);
            }

            .custom-tabs .nav-link.active {
                color: var(--text-inverse);
                background: var(--gradient-primary);
                box-shadow: 0 4px 12px var(--accent-glow);
            }

    .tab-content-box {
        background: var(--bg-card);
        border-radius: 12px;
        padding: 1rem;
        border: 1px solid var(--border-light);
    }

        .tab-content-box .tab-pane {
            color: var(--text-primary);
        }

        .tab-content-box .form-control,
        .tab-content-box .form-select {
            border-radius: 8px;
        }

        .tab-content-box .form-label {
            font-size: 0.875rem;
            font-weight: 500;
        }

        .tab-content-box .btn-primary {
            border: none;
            border-radius: 8px;
            font-weight: 500;
        }

            .tab-content-box .btn-primary:hover {
                box-shadow: 0 4px 12px var(--accent-glow);
            }

        .tab-content-box .table {
            font-size: 0.8rem;
        }

        .tab-content-box .alert-info {
            border-radius: 8px;
        }

    /* ========== ORTAK STİLLER ========== */
    .diagram-svg {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: var(--bg-primary);
    }

        .diagram-svg .svg-bg {
            fill: var(--bg-primary);
        }

        .diagram-svg .svg-title {
            fill: var(--text-primary);
        }

        /* Tıklanabilir grup nesneleri */
        .diagram-svg .ternary-shape {
            cursor: pointer;
        }

            .diagram-svg .ternary-shape:hover {
                filter: brightness(1.15);
            }

    .group-style-panel {
        border: 1px solid var(--accent-primary);
        border-radius: 12px;
        padding: 12px 14px;
        background: var(--accent-primary-lighter);
    }

    .swatch {
        display: inline-block;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border: 2px solid transparent;
        vertical-align: middle;
    }

    .group-table tbody tr {
        cursor: pointer;
    }

    .card {
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .handsontable {
        font-size: 12px;
    }

    .form-check:hover, .btn:hover, .card:hover {
        transform: none !important;
    }
</style>

@code {
    private HandsontableGrid? inputGrid;
    private List<TGroup> resultGroups = [];
    private List<Ttridata> calculatedData = [];
    private Dictionary<int, List<PointD>> calculatedPolygons = new();
    private TernaryCalculationService calculationService = new();
    private List<HandsontableGrid.ColumnConfig> inputColumns = [];

    private readonly Dictionary<int, string> groupIdToName = new();
    private readonly Dictionary<string, int> groupNameToId = new(StringComparer.OrdinalIgnoreCase);

    private bool showGradientFill = false;

    private int gradientOpacity = 40; // %40

    private string chartTitle = "Ternary Phase Diagram";
    private string titleOil = "Oil";
    private string titleSurfactant = "Surfactant";
    private string titleWater = "Water";
    private int polygonCloseType = 1;
    private int edgeType = 2;
    private int axisInterval = 10;
    private int borderAlpha = 180;
    private int fillAlpha = 80;

    // Bezier yumuşatma (şartname dışı görsel seçenek). Varsayılan kapalı: mevcut çıktılar
    // değişmesin. Kapatma noktaları grup başına ayrı tutulur ki eğri yalnız ölçüm
    // noktalarından geçsin, kenar üzerindeki kapatma segmentleri düz kalsın.
    private bool smoothEdges = false;
    private int smoothTension = 60;   // %60 ≈ klasik Catmull-Rom (1,0); %100 = 1,6 (daha yuvarlak)
    private readonly Dictionary<int, (PointD? start, PointD? end, PointD? lineA, PointD? lineB)> polygonClosings = new();

    // 1 ya da 2 geçerli noktası olan gruplar: bölge yerine nokta / çizgi olarak çizilir.
    // Eskiden 1 noktalı grup yalnız veri dairesi olarak görünür, 2 noktalı grup ise
    // kapatma modunda kapatma noktalarıyla dörtgen bir "bölge"ye dönüşürdü — iki ölçümden
    // bölge çıkarmak yanıltıcıydı. Merkez: nokta ya da orta nokta; alan 0.
    private readonly Dictionary<int, List<PointD>> smallGroups = new();
    private string selectedSample = "";
    // Arayüz dilindeki ilk değer OnInitialized'da atanır (L enjeksiyonu alan başlatıcısından sonra gelir).
    private string statusMessage = "";
    // Toplamı 100'den sapan satırlar (Hesapla sonrasında dolar; hesap engellenmez, kullanıcı düzeltir).
    private List<TernaryTotals.Deviation> totalWarnings = [];
    private string GroupName(int id) => groupIdToName.TryGetValue(id, out var n) ? n : $"{T("Grup")} {id}";
    private bool isLoaded = false;

    // Kısa yollar: arayüz metni / biçimli arayüz metni (anahtar = Türkçe kaynak metin).
    private string T(string key) => L[key].Value;
    private string T(string key, params object[] args) => L[key, args].Value;

    // ---- Seçim ve grup stilleri ----
    // Stil grup ADINA bağlı (sıraya değil): satır eklenip çıkarılınca renk kaymaz ve dosyaya
    // kaydedilen stil, aynı adlı grup tekrar girildiğinde geri gelir.
    private int? selectedGroup;
    private readonly Dictionary<string, GroupStyle> groupStyles = new(StringComparer.OrdinalIgnoreCase);

    // ---- Kalıcılık ----
    private const string LocalStorageKey = "PTCalc.ternary.document.v1";
    private const string SvgElementId = "ternary-svg";
    private List<object?[]> lastRows = new();          // son hesaplanan/yüklenen satırlar (otomatik kayıt için)
    private string autosaveNote = "";                 // ilk değer OnInitialized'da (arayüz dilinde)
    private bool hasLocalCopy;
    private bool restoring;                            // geri yükleme sırasında otomatik kaydı sustur

    private const double Sin60 = 0.86602540378443864676372317075294;
    private const double Cos60 = 0.5;
    private const double Tan30 = 0.5773502691896257645091487805019;
    private const double TriangleSide = 400.0;
    private const double TriangleHeight = TriangleSide * Sin60;

    private const double SvgWidth = 500;
    private const double SvgHeight = 450;
    private const double MarginTop = 50;

    private double TopX => SvgWidth / 2;
    private double TopY => MarginTop;
    private double LeftX => (SvgWidth - TriangleSide) / 2;
    private double LeftY => MarginTop + TriangleHeight;
    private double RightX => (SvgWidth + TriangleSide) / 2;
    private double RightY => MarginTop + TriangleHeight;

    private double ToSvgX(double x) => LeftX + x * TriangleSide;
    private double ToSvgY(double y) => LeftY - y * TriangleSide;

    private string GetStatusClass() => statusMessage.Contains("check-circle") ? "alert-success" :
    statusMessage.Contains("x-circle") || statusMessage.Contains("exclamation-circle") ? "alert-danger" : "alert-info";
    private string GetGroupColor(int i) => new[] { "#3b82f6", "#ef4444", "#22c55e", "#f59e0b", "#8b5cf6", "#ec4899" }[i % 6];
    private string F(double v) => v.ToString(CultureInfo.InvariantCulture);
    private static int Pct(double opacity) => (int)Math.Round(opacity * 100);
    private static int? ParseInt(object? v) => int.TryParse(v?.ToString(), out var i) ? i : null;
    private static double? ParseDouble(object? v) => double.TryParse(v?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var d) ? d : null;

    private int ClampByte(double v) => (int)Math.Clamp(Math.Round(v), 0, 255);

    // ================= Ayar değişiklikleri =================

    private async Task OnBorderAlphaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) borderAlpha = value;
        await AutosaveAsync();
    }

    private async Task OnFillAlphaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) fillAlpha = value;
        await AutosaveAsync();
    }

    private async Task OnGradientOpacityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) gradientOpacity = value;
        await AutosaveAsync();
    }

    private async Task OnPolygonCloseTypeChanged(int value)
    {
        polygonCloseType = value;
        RecalculatePolygons();
        await AutosaveAsync();
    }

    private async Task OnSmoothEdgesChanged(ChangeEventArgs e)
    {
        smoothEdges = e.Value is bool b && b;
        RecalculatePolygons();   // alan/merkez çerçeveye bağlı
        await AutosaveAsync();
    }

    private async Task OnSmoothTensionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            smoothTension = Math.Clamp(value, 0, 100);
            RecalculatePolygons();
            await AutosaveAsync();
        }
    }

    private async Task OnEdgeTypeChanged(int value)
    {
        edgeType = value;
        RecalculatePolygons();
        await AutosaveAsync();
    }

    // ================= Seçim ve stil =================

    private void SelectGroup(int groupNum) => selectedGroup = groupNum;
    private void ClearSelection() => selectedGroup = null;

    private bool GroupExists(int groupNum) => calculatedData.Any(d => d.grup == groupNum);

    private string GroupNameOf(int groupNum)
        => groupIdToName.TryGetValue(groupNum, out var name) ? name : groupNum.ToString();

    /// <summary>Grubun çizim stili: kullanıcı stili varsa o, yoksa palet rengi + genel opaklıklar.</summary>
    private EffectiveStyle StyleFor(int groupNum)
    {
        groupStyles.TryGetValue(GroupNameOf(groupNum), out var custom);
        return GroupStyles.Resolve(custom, GroupColorFor(groupNum), fillAlpha, borderAlpha);
    }

    private async Task UpdateStyleAsync(int groupNum, Action<GroupStyle> change)
    {
        var name = GroupNameOf(groupNum);
        if (!groupStyles.TryGetValue(name, out var style))
            groupStyles[name] = style = new GroupStyle();
        change(style);
        if (style.IsEmpty) groupStyles.Remove(name);
        await AutosaveAsync();
    }

    private async Task ResetStyleAsync(int groupNum)
    {
        groupStyles.Remove(GroupNameOf(groupNum));
        await AutosaveAsync();
    }

    // ================= Kalıcılık (A: localStorage, B: dosya) =================

    private TernaryDocument BuildDocument() => new()
    {
        Rows = lastRows.Select(r => (object?[])r.Clone()).ToList(),
        Settings = new TernarySettings
        {
            ChartTitle = chartTitle, TitleOil = titleOil, TitleSurfactant = titleSurfactant, TitleWater = titleWater,
            PolygonCloseType = polygonCloseType, EdgeType = edgeType, AxisInterval = axisInterval,
            BorderAlpha = borderAlpha, FillAlpha = fillAlpha,
            SmoothEdges = smoothEdges, SmoothTension = smoothTension,
            ShowGradientFill = showGradientFill, GradientOpacity = gradientOpacity
        },
        Styles = new Dictionary<string, GroupStyle>(groupStyles, StringComparer.OrdinalIgnoreCase)
    };

    private void ApplySettings(TernarySettings s)
    {
        chartTitle = s.ChartTitle; titleOil = s.TitleOil; titleSurfactant = s.TitleSurfactant; titleWater = s.TitleWater;
        polygonCloseType = s.PolygonCloseType is >= 0 and <= 2 ? s.PolygonCloseType : 1;
        edgeType = s.EdgeType is >= 0 and <= 2 ? s.EdgeType : 2;
        axisInterval = s.AxisInterval is 5 or 10 or 20 ? s.AxisInterval : 10;
        borderAlpha = Math.Clamp(s.BorderAlpha, 10, 255);
        fillAlpha = Math.Clamp(s.FillAlpha, 10, 255);
        smoothEdges = s.SmoothEdges;
        smoothTension = Math.Clamp(s.SmoothTension, 0, 100);
        showGradientFill = s.ShowGradientFill;
        gradientOpacity = Math.Clamp(s.GradientOpacity, 10, 100);
    }

    /// <summary>Belgeyi bu tarayıcıya yazar. Geri yükleme sırasında ve grid hazır değilken sessizce geçer.</summary>
    private async Task AutosaveAsync()
    {
        if (restoring || !isLoaded) return;
        try
        {
            var ok = await JS.InvokeAsync<bool>("ternaryStore.save", LocalStorageKey, BuildDocument().ToJson());
            hasLocalCopy = ok;
            autosaveNote = ok
                ? T("Bu tarayıcıda otomatik kaydedildi ({0}).", DateTime.Now.ToString("HH:mm:ss"))
                : T("Bu tarayıcıda saklama kullanılamıyor (özel pencere olabilir).");
        }
        catch (JSException) { autosaveNote = T("Otomatik kayıt başarısız."); }
    }

    private async Task OnGridChangedAsync(List<object[]> _)
    {
        // Kullanıcı hücre değiştirdi: satırları yeniden oku ki otomatik kayıt güncel kalsın.
        if (inputGrid is null || restoring) return;
        lastRows = RowsFromGrid(await inputGrid.GetDataAsync());
        await AutosaveAsync();
    }

    private async Task ForgetLocalAsync()
    {
        try { await JS.InvokeVoidAsync("ternaryStore.remove", LocalStorageKey); } catch (JSException) { }
        hasLocalCopy = false;
        autosaveNote = T("Bu tarayıcıdaki kopya silindi; bir sonraki değişiklikte yeniden kaydedilir.");
    }

    private async Task SaveToFileAsync()
    {
        if (inputGrid is not null)
            lastRows = RowsFromGrid(await inputGrid.GetDataAsync());
        var name = $"ternary-{DateTime.Now:yyyyMMdd-HHmm}.json";
        try
        {
            await JS.InvokeVoidAsync("ternaryStore.downloadText", name, BuildDocument().ToJson(), "application/json;charset=utf-8");
            statusMessage = $"<i class='bi bi-check-circle-fill'></i> {T("{0} indirildi.", name)}";
        }
        catch (JSException ex) { statusMessage = $"<i class='bi bi-x-circle-fill'></i> {T("Dosya oluşturulamadı: {0}", ex.Message)}"; }
    }

    private async Task OpenFromFileAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 2 * 1024 * 1024;
        if (e.File.Size > maxBytes) { statusMessage = $"<i class='bi bi-x-circle-fill'></i> {T("Dosya çok büyük (en fazla 2 MB).")}"; return; }

        string json;
        using (var reader = new StreamReader(e.File.OpenReadStream(maxBytes)))
            json = await reader.ReadToEndAsync();

        var doc = TernaryDocument.FromJson(json);
        if (doc is null) { statusMessage = $"<i class='bi bi-x-circle-fill'></i> {T("Dosya okunamadı: bu bir maege.tr diyagram dosyası değil.")}"; return; }

        await RestoreDocumentAsync(doc);
        statusMessage = $"<i class='bi bi-check-circle-fill'></i> {T("{0} yüklendi ({1} satır).", e.File.Name, doc.Rows.Count)}";
        await AutosaveAsync();
    }

    private async Task DownloadSvgAsync()
    {
        try
        {
            var name = $"ternary-{DateTime.Now:yyyyMMdd-HHmm}.svg";
            var ok = await JS.InvokeAsync<bool>("ternaryStore.downloadSvg", SvgElementId, name);
            statusMessage = ok
                ? $"<i class='bi bi-check-circle-fill'></i> {T("{0} indirildi.", name)}"
                : $"<i class='bi bi-x-circle-fill'></i> {T("SVG bulunamadı.")}";
        }
        catch (JSException ex) { statusMessage = $"<i class='bi bi-x-circle-fill'></i> {T("SVG oluşturulamadı: {0}", ex.Message)}"; }
    }

    /// <summary>Belgeyi sayfaya uygular: ayarlar, stiller, grid satırları; satır varsa hesaplar.</summary>
    private async Task RestoreDocumentAsync(TernaryDocument doc)
    {
        restoring = true;
        try
        {
            ApplySettings(doc.Settings);
            groupStyles.Clear();
            foreach (var kv in doc.Styles) groupStyles[kv.Key] = kv.Value;
            selectedGroup = null;

            if (inputGrid is not null)
            {
                await inputGrid.UpdateDataAsync(doc.Rows.Count > 0 ? doc.Rows : new List<object?[]>());
                lastRows = doc.Rows;
                if (doc.Rows.Count > 0) await CalculateDiagram();
                else { resultGroups.Clear(); calculatedData.Clear(); calculatedPolygons.Clear(); }
            }
        }
        finally { restoring = false; }
        StateHasChanged();
    }

    /// <summary>Grid'in JSON dizisini ilkel hücrelere çevirir; tamamen boş satırları atar.</summary>
    private static List<object?[]> RowsFromGrid(object? gridData)
    {
        var rows = new List<object?[]>();
        if (gridData is not JsonElement json || json.ValueKind != JsonValueKind.Array) return rows;
        foreach (var row in json.EnumerateArray())
        {
            if (row.ValueKind != JsonValueKind.Array) continue;
            var cells = row.EnumerateArray().Select(c => c.ValueKind switch
            {
                JsonValueKind.Number => (object?)c.GetDouble(),
                JsonValueKind.String => string.IsNullOrWhiteSpace(c.GetString()) ? null : c.GetString(),
                _ => null
            }).ToArray();
            if (cells.Any(c => c is not null)) rows.Add(cells);
        }
        return rows;
    }

    // ================= Geometri =================

    /// <summary>
    /// Ölçüm noktaları + kapatma noktalarından yumuşatılmış çerçeve. Kapatma noktası
    /// komşu ölçüm noktasıyla çakışıyorsa PolygonSmoother onu düşürür (bu durum gerçekten
    /// oluyor: ölçüm zaten kenardaysa eklenen nokta aynı yere gelir).
    /// </summary>
    private PolygonSmoother.SmoothedOutline? BuildSmoothed(int groupNum, List<PointD> polygonPoints)
    {
        if (!smoothEdges) return null;

        polygonClosings.TryGetValue(groupNum, out var closing);
        int skipStart = closing.start is null ? 0 : 1;
        int skipEnd = closing.end is null ? 0 : 1;
        if (polygonPoints.Count - skipStart - skipEnd < 2) return null;

        var data = polygonPoints.Skip(skipStart).Take(polygonPoints.Count - skipStart - skipEnd).ToList();

        // Kontrol noktaları üçgenin dışına çıkamasın: Bezier, kontrol noktalarının dışbükey
        // zarfında kalır; dolayısıyla eğri de üçgende kalır. Min-değer kapatmasında (mod 1)
        // bölge ayrıca kapatma çizgisiyle kesilir ki eğri o çizginin ötesine sarkmasın.
        // Kenar kapatmasında (mod 2) çizgi zaten üçgen kenarıdır, kesme değişiklik yapmaz.
        var region = PolygonSmoother.ConvexRegion.Triangle(
            new PointD { X = 0, Y = 0 }, new PointD { X = 1, Y = 0 }, new PointD { X = 0.5, Y = Sin60 });
        if (closing.start is not null && closing.lineA is not null && closing.lineB is not null)
        {
            var keep = new PointD { X = data.Average(q => q.X), Y = data.Average(q => q.Y) };
            region = region.ClipByLine(closing.lineA, closing.lineB, keep);
        }

        var outline = PolygonSmoother.Build(data, closing.start, closing.end,
            smoothTension / 100.0 * PolygonSmoother.MaxTension, region);
        return outline.Curve.Count == 0 ? null : outline;
    }

    /// <summary>
    /// Grubun merkezini ve alanını yazar. ≥3 nokta: (yumuşatılmış) çokgenin ağırlık merkezi ve
    /// alanı. 2 nokta: orta nokta, alan 0. 1 nokta: noktanın kendisi, alan 0.
    /// Hiçbiri yoksa (grubun geçerli noktası yok) merkez temizlenir.
    /// </summary>
    private void UpdateGroupMetrics(TGroup group)
    {
        var groupNum = group.N;
        PointD centroid;
        double area;

        if (calculatedPolygons.TryGetValue(groupNum, out var polygonPoints) && polygonPoints.Count >= 3)
            (centroid, area) = CalculatePolygonCentroidAndArea(OutlineForMetrics(groupNum, polygonPoints));
        else if (smallGroups.TryGetValue(groupNum, out var pts) && pts.Count > 0)
        {
            centroid = pts.Count == 1
                ? pts[0]
                : new PointD { X = (pts[0].X + pts[1].X) / 2, Y = (pts[0].Y + pts[1].Y) / 2 };
            area = 0;
        }
        else
        {
            group.PolygonCenterD = null;
            group.A = group.B = group.C = group.Area = 0;
            return;
        }

        group.PolygonCenterD ??= new PointD();
        group.PolygonCenterD.X = centroid.X;
        group.PolygonCenterD.Y = centroid.Y;
        group.A = (centroid.Y / Sin60) * 100;
        group.B = (centroid.X - centroid.Y * Tan30) * 100;
        group.C = (1 - (centroid.Y * Tan30 + centroid.X)) * 100;
        group.Area = area * 10000;
    }

    /// <summary>Grubun palet rengi: tüm gruplar içindeki sırasına göre (veri daireleriyle aynı sıra).</summary>
    private string GroupColorFor(int groupNum)
    {
        var order = calculatedData.Select(d => d.grup).Distinct().OrderBy(g => g).ToList();
        int idx = order.IndexOf(groupNum);
        return GetGroupColor(idx < 0 ? 0 : idx);
    }

    /// <summary>Alan/merkez için kullanılacak çokgen: yumuşatma açıksa örneklenmiş eğri, değilse ham poligon.</summary>
    private List<PointD> OutlineForMetrics(int groupNum, List<PointD> polygonPoints)
    {
        var outline = BuildSmoothed(groupNum, polygonPoints);
        return outline is null ? polygonPoints : PolygonSmoother.SampleOutline(outline, 12);
    }

    /// <summary>SVG path "d" verisi: kapatma noktalarına düz, ölçüm noktaları arasında kübik Bezier.</summary>
    private string SmoothPathData(PolygonSmoother.SmoothedOutline o)
    {
        var sb = new System.Text.StringBuilder();
        string Pt(PointD q) => $"{F(ToSvgX(q.X))},{F(ToSvgY(q.Y))}";

        var first = o.Curve[0].P0;
        if (o.Start is not null) { sb.Append("M ").Append(Pt(o.Start)).Append(" L ").Append(Pt(first)); }
        else sb.Append("M ").Append(Pt(first));

        foreach (var seg in o.Curve)
            sb.Append(" C ").Append(Pt(seg.C1)).Append(' ').Append(Pt(seg.C2)).Append(' ').Append(Pt(seg.P3));

        if (o.End is not null) sb.Append(" L ").Append(Pt(o.End));
        sb.Append(" Z");
        return sb.ToString();
    }

    /// <summary>
    /// SVG &lt;text&gt; öğesi. Razor'da "&lt;text&gt;" özel bir etikettir ve öznitelik alamaz
    /// (RZ1023); bu yüzden metinler RenderTreeBuilder ile üretilir.
    /// </summary>
    private void SvgText(RenderTreeBuilder b, double x, double y, string anchor, int fontSize,
                         string? fontWeight, string? fill, string? cssClass, string? transform, string content)
    {
        b.OpenElement(0, "text");
        b.AddAttribute(1, "x", F(x));
        b.AddAttribute(2, "y", F(y));
        b.AddAttribute(3, "text-anchor", anchor);
        b.AddAttribute(4, "font-size", fontSize.ToString(CultureInfo.InvariantCulture));
        if (fontWeight is not null) b.AddAttribute(5, "font-weight", fontWeight);
        if (fill is not null) b.AddAttribute(6, "fill", fill);
        if (cssClass is not null) b.AddAttribute(7, "class", cssClass);
        if (transform is not null) b.AddAttribute(8, "transform", transform);
        b.AddContent(9, content);
        b.CloseElement();
    }

    private string PolygonPointsAttr(List<PointD> pts)
        => string.Join(" ", pts.Select(p => $"{F(ToSvgX(p.X))},{F(ToSvgY(p.Y))}"));

    private void RecalculatePolygons()
    {
        if (calculatedData.Count == 0) return;

        calculatedPolygons = CalculatePolygonPoints(calculatedData, polygonCloseType, edgeType);

        foreach (var group in resultGroups)
            UpdateGroupMetrics(group);
    }

    // ================= SVG =================

    /// <summary>
    /// Gradient dolgu hücreleri. Nokta yerine küçük kareler: dikiş/boşluk oluşmaz.
    /// gradientOpacity (%10..%100) "beyaza karışım" oranı gibi kullanılır: 0 → beyaz, 1 → saf ternary renk.
    /// </summary>
    private IEnumerable<(double x, double y, string color)> GradientCells()
    {
        double lighten = Math.Clamp(gradientOpacity / 100.0, 0.0, 1.0);
        const double pxStep = 3.0;
        const double half = pxStep / 2.0;

        for (double ySvg = 0; ySvg <= TriangleHeight; ySvg += pxStep)
        {
            double y = Math.Min(Sin60, ySvg / TriangleSide);
            double t = y / Sin60;
            double leftSvg = ToSvgX(0.5 * t);
            double rightSvg = ToSvgX(1 - 0.5 * t);
            double cySvg = ToSvgY(y) - half;

            for (double xSvg = leftSvg; xSvg <= rightSvg; xSvg += pxStep)
            {
                double x = (xSvg - LeftX) / TriangleSide;
                double oil = y / Sin60;
                double surf = x - y * Tan30;
                double water = 1 - oil - surf;
                if (oil < 0) oil = 0; if (surf < 0) surf = 0; if (water < 0) water = 0;
                double max = Math.Max(oil, Math.Max(surf, water));
                if (max > 0) { oil /= max; surf /= max; water /= max; }

                int r = ClampByte(255 - lighten * (255 - 255 * oil));
                int g = ClampByte(255 - lighten * (255 - 255 * surf));
                int b = ClampByte(255 - lighten * (255 - 255 * water));
                yield return (xSvg - half, cySvg, $"rgb({r},{g},{b})");
            }
        }
    }

    private const double GradientCell = 3.25;   // pxStep + 0.25 (komşu hücreler binerek dikişi kapatır)

    /// <summary>
    /// Diyagram, Razor işaretlemesi olarak üretilir (eski hâli tek bir metin/MarkupString idi).
    /// Böylece grup nesnelerine @onclick bağlanabiliyor; SVG'nin kendisine tıklamak seçimi kaldırır,
    /// nesneler olayı yukarı taşımaz.
    /// </summary>
    private RenderFragment RenderSvgMarkup() => __builder =>
    {
        int tickCount = 100 / axisInterval;
        var trianglePoints = $"{F(TopX)},{F(TopY)} {F(LeftX)},{F(LeftY)} {F(RightX)},{F(RightY)}";

        <svg id="@SvgElementId" width="100%" height="@F(SvgHeight)" viewBox="0 0 @F(SvgWidth) @F(SvgHeight)" class="diagram-svg" style="color-scheme: light dark;"
             @onclick="ClearSelection">
            <defs>
                <clipPath id="triangleClip">
                    <polygon points="@trianglePoints" />
                </clipPath>
            </defs>

            @if (!showGradientFill)
            {
                <polygon class="svg-bg" points="@trianglePoints" stroke="none" />
            }
            else
            {
                <g clip-path="url(#triangleClip)" shape-rendering="crispEdges">
                    @foreach (var c in GradientCells())
                    {
                        <rect x="@F(c.x)" y="@F(c.y)" width="@F(GradientCell)" height="@F(GradientCell)" fill="@c.color" fill-opacity="1" stroke="none" />
                    }
                </g>
            }

            @for (int k = 0; k <= tickCount; k++)
            {
                double iVal = (double)k / tickCount;
                double aVal = iVal * Cos60;
                double bVal = iVal * Sin60;
                double oilX1 = ToSvgX(aVal), oilY1 = ToSvgY(bVal), oilX2 = ToSvgX(1 - aVal);
                double oilTickX = ToSvgX(aVal - 0.02);
                double surfX1 = ToSvgX(1 - aVal), surfY1 = ToSvgY(bVal), surfX2 = ToSvgX(1 - iVal), surfY2 = ToSvgY(0);
                double surfTickX = ToSvgX(1 - aVal + 0.02 * Cos60), surfTickY = ToSvgY(bVal + 0.02 * Sin60);
                int surfLabel = ((tickCount - k) * 100) / tickCount;
                double waterX1 = ToSvgX(iVal), waterY1 = ToSvgY(0), waterX2 = ToSvgX(aVal), waterY2 = ToSvgY(bVal);
                double waterTickBaseX = ToSvgX(1 - iVal), waterTickBaseY = ToSvgY(0);
                double waterTickX = ToSvgX((1 - iVal) + 0.02 * Cos60), waterTickY = ToSvgY(-0.02);

                if (k > 0 && k < tickCount)
                {
                    <line x1="@F(oilX1)" y1="@F(oilY1)" x2="@F(oilX2)" y2="@F(oilY1)" stroke="#ef4444" stroke-width="0.5" opacity="0.25" />
                    <line x1="@F(surfX1)" y1="@F(surfY1)" x2="@F(surfX2)" y2="@F(surfY2)" stroke="#22c55e" stroke-width="0.5" opacity="0.25" />
                    <line x1="@F(waterX1)" y1="@F(waterY1)" x2="@F(waterX2)" y2="@F(waterY2)" stroke="#3b82f6" stroke-width="0.5" opacity="0.25" />
                }
                <line x1="@F(oilX1)" y1="@F(oilY1)" x2="@F(oilTickX)" y2="@F(oilY1)" stroke="#ef4444" stroke-width="1.5" />
                SvgText(__builder, oilTickX - 3, oilY1 + 4, "end", 10, null, "#ef4444", null, null, (k * axisInterval).ToString()); 
                <line x1="@F(surfX1)" y1="@F(surfY1)" x2="@F(surfTickX)" y2="@F(surfTickY)" stroke="#22c55e" stroke-width="1.5" />
                SvgText(__builder, surfTickX + 5, surfTickY + 4, "start", 10, null, "#22c55e", null, null, surfLabel.ToString()); 
                <line x1="@F(waterTickBaseX)" y1="@F(waterTickBaseY)" x2="@F(waterTickX)" y2="@F(waterTickY)" stroke="#3b82f6" stroke-width="1.5" />
                SvgText(__builder, waterTickX, waterTickY + 15, "middle", 10, null, "#3b82f6", null, null, (k * axisInterval).ToString()); 
            }

            <line x1="@F(ToSvgX(0))" y1="@F(ToSvgY(0))" x2="@F(ToSvgX(1))" y2="@F(ToSvgY(0))" stroke="#3b82f6" stroke-width="2.5" />
            <line x1="@F(ToSvgX(1))" y1="@F(ToSvgY(0))" x2="@F(ToSvgX(0.5))" y2="@F(ToSvgY(Sin60))" stroke="#22c55e" stroke-width="2.5" />
            <line x1="@F(ToSvgX(0.5))" y1="@F(ToSvgY(Sin60))" x2="@F(ToSvgX(0))" y2="@F(ToSvgY(0))" stroke="#ef4444" stroke-width="2.5" />

            @* Faz bölgeleri (≥3 nokta). Seçili grup: kalın + kesikli kenar. *@
            @foreach (var kvp in calculatedPolygons.OrderBy(k => k.Key))
            {
                var groupNum = kvp.Key;
                var polygonPoints = kvp.Value;
                if (polygonPoints.Count < 3) { continue; }
                var st = StyleFor(groupNum);
                bool isSel = selectedGroup == groupNum;
                var sw = F(isSel ? st.StrokeWidth + 2 : st.StrokeWidth);
                var dash = isSel ? "6 3" : null;
                var smoothed = BuildSmoothed(groupNum, polygonPoints);

                if (smoothed is not null)
                {
                    <path class="ternary-shape" d="@SmoothPathData(smoothed)"
                          fill="@st.Fill" fill-opacity="@F(st.FillOpacity)" stroke="@st.Stroke" stroke-width="@sw"
                          stroke-opacity="@F(st.StrokeOpacity)" stroke-linejoin="round" stroke-dasharray="@dash"
                          @onclick="() => SelectGroup(groupNum)" @onclick:stopPropagation="true" />
                }
                else
                {
                    <polygon class="ternary-shape" points="@PolygonPointsAttr(polygonPoints)"
                             fill="@st.Fill" fill-opacity="@F(st.FillOpacity)" stroke="@st.Stroke" stroke-width="@sw"
                             stroke-opacity="@F(st.StrokeOpacity)" stroke-linejoin="round" stroke-dasharray="@dash"
                             @onclick="() => SelectGroup(groupNum)" @onclick:stopPropagation="true" />
                }
            }

            @* 1–2 noktalı gruplar: tek nokta → vurgulu daire, iki nokta → çizgi (bölge değil). *@
            @foreach (var kvp in smallGroups.OrderBy(k => k.Key))
            {
                var groupNum = kvp.Key;
                var pts = kvp.Value;
                var st = StyleFor(groupNum);
                bool isSel = selectedGroup == groupNum;
                var dash = isSel ? "6 3" : null;

                if (pts.Count == 1)
                {
                    <circle class="ternary-shape" cx="@F(ToSvgX(pts[0].X))" cy="@F(ToSvgY(pts[0].Y))" r="8"
                            fill="@st.Fill" fill-opacity="@F(st.FillOpacity)" stroke="@st.Stroke"
                            stroke-width="@F(isSel ? st.StrokeWidth + 2 : st.StrokeWidth)" stroke-opacity="@F(st.StrokeOpacity)" stroke-dasharray="@dash"
                            @onclick="() => SelectGroup(groupNum)" @onclick:stopPropagation="true" />
                }
                else if (pts.Count == 2)
                {
                    <line class="ternary-shape" x1="@F(ToSvgX(pts[0].X))" y1="@F(ToSvgY(pts[0].Y))" x2="@F(ToSvgX(pts[1].X))" y2="@F(ToSvgY(pts[1].Y))"
                          stroke="@st.Stroke" stroke-width="@F(isSel ? st.StrokeWidth + 3 : st.StrokeWidth + 1)" stroke-opacity="@F(st.StrokeOpacity)"
                          stroke-linecap="round" stroke-dasharray="@dash"
                          @onclick="() => SelectGroup(groupNum)" @onclick:stopPropagation="true" />
                }
            }

            @* Veri noktaları: grup kenar rengiyle; tıklanınca grubu seçer *@
            @foreach (var grp in calculatedData.GroupBy(d => d.grup).OrderBy(g => g.Key))
            {
                var groupNum = grp.Key;
                var color = StyleFor(groupNum).Stroke;
                foreach (var p in grp.OrderBy(d => d.siraNo).Where(d => d.p != null))
                {
                    <circle class="ternary-shape" cx="@F(ToSvgX(p.p!.X))" cy="@F(ToSvgY(p.p!.Y))" r="4" fill="@color" stroke="white" stroke-width="1"
                            @onclick="() => SelectGroup(groupNum)" @onclick:stopPropagation="true" />
                }
            }

            @* Grup merkezleri *@
            @foreach (var group in resultGroups.Where(g => g.PolygonCenterD != null))
            {
                <circle cx="@F(ToSvgX(group.PolygonCenterD!.X))" cy="@F(ToSvgY(group.PolygonCenterD!.Y))" r="5" fill="red" stroke="white" stroke-width="1.5" />
            }

            @if (!string.IsNullOrWhiteSpace(chartTitle))
            {
                SvgText(__builder, SvgWidth / 2, 20, "middle", 18, "bold", null, "svg-title", null, chartTitle);
            }

            @{
                double oilLabelX = ToSvgX(0.5 * Cos60 - 0.08), oilLabelY = ToSvgY(0.5 * Sin60);
                double surfLabelX = ToSvgX(1 - 0.5 * Cos60 + 0.08), surfLabelY = ToSvgY(0.5 * Sin60);
            }
            @{
                SvgText(__builder, oilLabelX, oilLabelY, "middle", 14, "bold", "#ef4444", null, $"rotate(-60, {F(oilLabelX)}, {F(oilLabelY)})", titleOil);
                SvgText(__builder, surfLabelX, surfLabelY, "middle", 14, "bold", "#22c55e", null, $"rotate(60, {F(surfLabelX)}, {F(surfLabelY)})", titleSurfactant);
                SvgText(__builder, ToSvgX(0.5), ToSvgY(-0.12), "middle", 14, "bold", "#3b82f6", null, null, titleWater);
            }
        </svg>
    };


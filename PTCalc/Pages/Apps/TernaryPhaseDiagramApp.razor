    private int GetOrCreateGroupId(string groupNameRaw)
    {
        var groupName = (groupNameRaw ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(groupName))
            groupName = "-";

        if (groupNameToId.TryGetValue(groupName, out var existing))
            return existing;

        var newId = groupNameToId.Count == 0 ? 1 : groupNameToId.Values.Max() + 1;
        groupNameToId[groupName] = newId;
        groupIdToName[newId] = groupName;
        return newId;
    }


@page "/"
@using System.Globalization
@using PTCalc.Site
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@namespace PTCalc.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IStringLocalizer<PTCalc.SharedResource> L
@{
    // Dil gelen alan adından (ptcalc.tr Türkçe, ptcalc.net İngilizce) ya da çerezden;
    // kültür UseRequestLocalization ile çoktan belirlendi.
    var site = SiteProfiles.Resolve(Request.Host.Value);
    var culture = CultureInfo.CurrentUICulture.Name;
    var lang = culture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "en" : "tr";
    var path = Request.Path.Value ?? "/";
    var siteTitle = $"PTCalc · {L["Farmasötik teknoloji için istatistik ve hesaplama araçları"]}";
    var description = lang == "en"
        ? L["EPT_MetaAciklama"].Value
        : "Farmasötik teknoloji için ücretsiz, açık kaynak hesaplama araçları: dissolüsyon kinetiği (16 model, AIC sıralaması), f1/f2 benzerlik faktörleri, alan ve merkez hesaplı psödo-üçlü faz diyagramı, LD50 doz–yanıt ve t-testi. Türkçe sürüm ptcalc.tr, İngilizce sürüm ptcalc.net.";
    var canonical = SiteProfiles.CanonicalUrl(path, culture);
    var alternates = SiteProfiles.Alternates(path);
    var ogLocale = lang == "en" ? "en_US" : "tr_TR";
    // Marka görselleri: salım eğrisi işareti (/img/ptcalc, tools/make_brand.py üretir). Paylaşım görseli dile göre.
    var iconSvg = "/img/ptcalc/favicon.svg";
    var iconPng = "/img/ptcalc/icon-32.png";
    var appleIcon = "/img/ptcalc/apple-touch-icon.png";
    var ogImage = $"{Request.Scheme}://{Request.Host}/img/ptcalc/og-image-{lang}.png";
    var ogImageAlt = "PTCalc · Pharmaceutical technology calculation tools";
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <base href="~/" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Tabler Icons (anasayfa kutu ikonları) -->
    <link href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" rel="stylesheet" />

    <!-- Font for Chart.js canvas text (ensures Turkish glyphs like 'ı' render) -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet" />

    <!-- Handsontable CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/handsontable@14.1.0/dist/handsontable.full.min.css" />

    <!-- Theme CSS -->
    <link href="css/theme.css" rel="stylesheet" asp-append-version="true" />

    <!-- Site CSS -->
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/rehber.css" rel="stylesheet" asp-append-version="true" />
    <link href="PTCalc.styles.css" rel="stylesheet" asp-append-version="true" />

    <!-- Başlık: sayfa kendi <PageTitle>'ını verirse HeadOutlet bunu ezer -->
    <title>@siteTitle</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#0d9488" />
    <meta name="application-name" content="@site.BrandName" />
    <link rel="canonical" href="@canonical" />
    @foreach (var (altLang, url) in alternates)
    {
        <link rel="alternate" hreflang="@altLang" href="@url" />
    }

    <!-- Paylaşım kartları -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@site.BrandName" />
    <meta property="og:title" content="@siteTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@ogImageAlt" />
    <meta property="og:locale" content="@ogLocale" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Logo/favicon: salım eğrisi işareti -->
    <link rel="icon" type="image/svg+xml" href="@iconSvg" />
    <link rel="icon" type="image/png" sizes="16x16 32x32 48x48" href="@iconPng" />
    <link rel="apple-touch-icon" sizes="180x180" href="@appleIcon" />
    <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />

    <!-- Theme Manager (flash önleme için head'de) -->
    <script src="js/theme-manager.js" asp-append-version="true"></script>
    <script src="js/anchor-links.js" asp-append-version="true"></script>
    <script src="js/pwa.js" asp-append-version="true"></script>

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" param-HostName="@Request.Host.Value" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <!-- Handsontable JS -->
    <script src="https://cdn.jsdelivr.net/npm/handsontable@14.1.0/dist/handsontable.full.min.js"></script>
    <script src="js/handsontable-interop.js" asp-append-version="true"></script>

    <!-- Chart.js v2.9.4 (ChartJs.Blazor.Fork requires this version) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>

    <!-- Chart interop (must be available before Blazor JS interop calls) -->
    <script src="js/chart-interop.js" asp-append-version="true"></script>
    <script src="js/ternary-interop.js" asp-append-version="true"></script>

    <!-- Blazor -->
    <script src="_framework/blazor.server.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Blazor -> Bootstrap modal koprusu (bootstrap.bundle SONRASINDA) -->
    <script src="js/bootstrap-modal.js" asp-append-version="true"></script>

    <!-- Ion Icons -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
</body>
</html>

                    </tr>
                    <tr>
                        <th scope="row">IIIb</th>
                        <td>p → q</td>
                        <td>q = p · ρ<sub>20</sub>(p) / ρ<sub>20</sub>(%100)</td>
                        <td>% w/w → % v/v dönüşümü</td>
                    </tr>
                    <tr>
                        <th scope="row">IVa</th>
                        <td>q → ρ<sub>20</sub></td>
                        <td>Önce IIIb'den q → p, sonra denklem</td>
                        <td>Dereceden yoğunluk (% v/v), 20 °C</td>
                    </tr>
                    <tr>
                        <th scope="row">IVb</th>

@using PTCalc.Middleware
@using Microsoft.JSInterop
@implements IAsyncDisposable

<div id="@ElementId" style="height:@Height; width:@Width;"></div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Parameter] public string ElementId { get; set; } = $"hot_{Guid.NewGuid():N}";
    [Parameter] public object?[][] Data { get; set; } = Array.Empty<object?[]>();
    [Parameter] public List<HotColumn> Columns { get; set; } = new();
    [Parameter] public int MinRows { get; set; } = 100; // VB'ye yakın
    [Parameter] public int HeightPx { get; set; } = 420;

    [Parameter] public string Height { get; set; } = "420px";
    [Parameter] public string Width { get; set; } = "100%";

    private DotNetObjectReference<HotGrid>? _dotNetRef;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _dotNetRef = DotNetObjectReference.Create(this);

        var options = new
        {
            minRows = MinRows,
            height = HeightPx,
            readOnly = false,
            columns = Columns.Select(c => new
            {
                Title = c.Title,
                Data = c.Data,          // sadece isim; JS tarafı array index kullanıyor
                Type = c.Type,
                Width = c.Width,
                ReadOnly = c.ReadOnly,
                NumericFormat = c.NumericFormat
            }).ToArray()
        };

        await JS.InvokeVoidAsync("handsontableHelper.initialize", ElementId, _dotNetRef, options);
        await JS.InvokeVoidAsync("handsontableHelper.updateData", ElementId, Data);

        _initialized = true;
    }

    public async Task LoadDataAsync(object?[][] data)
    {
        if (!_initialized) return;
        await JS.InvokeVoidAsync("handsontableHelper.updateData", ElementId, data);
    }

    public async Task<object?[][]> GetDataAsync()
    {
        if (!_initialized) return Array.Empty<object?[]>();
        return await JS.InvokeAsync<object?[][]>("handsontableHelper.getData", ElementId)
               ?? Array.Empty<object?[]>();
    }

    public async Task AddRowAsync()
    {
        if (!_initialized) return;
        await JS.InvokeVoidAsync("handsontableHelper.addRow", ElementId);
    }

    public async Task DeleteSelectedRowAsync()
    {
        if (!_initialized) return;
        await JS.InvokeVoidAsync("handsontableHelper.deleteSelectedRow", ElementId);
    }

    [JSInvokable]
    public Task OnCellChanged(object changes)
    {
        // Şimdilik boş bırakabilirsiniz.
        // İsterseniz burada değişiklikleri yakalayıp state güncellemesi yaparız.
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_initialized)
                await JS.InvokeVoidAsync("handsontableHelper.destroy", ElementId);
        }
        catch { /* ignore */ }

        _dotNetRef?.Dispose();
    }

    public sealed record HotColumn(
        string Title,
        string Data,
        string Type = "numeric",
        int Width = 80,
        bool ReadOnly = false,
        string? NumericFormat = "0.00"
    );
}

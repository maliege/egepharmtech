@using System.Globalization
@using EgePharmTech.Site
@using Microsoft.Extensions.Localization
@using EgePharmTech.Components.UI
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

@* Üst menü: farmasötik teknoloji araçları, rehberler, hakkında/iletişim, tema ve dil anahtarı (TR/EN).
   Araçlar hesap gerektirmez; giriş/kayıt yok. Hamburger eşiği xl (1200 px). *@
<nav class="navbar navbar-expand-xl navbar-light bg-light navbar-custom fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand brand me-4" href="/" aria-label="@Site.BrandName @L["ana sayfa"]">
            @* EgePharmTech işareti: yuvarlatılmış kare içinde salım eğrisi ve üç veri noktası (img/egepharmtech/favicon.svg ile aynı geometri) *@
            <svg class="brand-mark brand-mark-pharmtech" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <rect width="64" height="64" rx="14" fill="currentColor" />
                <path d="M12 50 C 27 50, 24 14, 54 14" fill="none" class="brand-mark-stroke" stroke-width="5.2" stroke-linecap="round" />
                <circle cx="19.8" cy="45.5" r="5.4" class="brand-mark-inner-fill" />
                <circle cx="19.8" cy="45.5" r="2.6" fill="currentColor" />
                <circle cx="27.4" cy="32" r="5.4" class="brand-mark-inner-fill" />
                <circle cx="27.4" cy="32" r="2.6" fill="currentColor" />
                <circle cx="40.7" cy="17.1" r="5.4" class="brand-mark-inner-fill" />
                <circle cx="40.7" cy="17.1" r="2.6" fill="currentColor" />
            </svg>
            <span class="brand-text">@Site.BrandName</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll"
                aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarScroll">
            <ul class="navbar-nav me-auto my-2 my-xl-0 navbar-nav-scroll">
                <li class="nav-item me-3">
                    <a class="nav-link" aria-current="page" href="/">@L["Anasayfa"]</a>
                </li>
                <li class="nav-item dropdown me-3">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @L["Farmasötik Teknoloji"]
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="ternary-phase-diagram-app">@L["Ternary Phase Diagram"]</a></li>
                        <li><a class="dropdown-item" href="kinetik">@L["Kinetik Analiz"]</a></li>
                        <li><a class="dropdown-item" href="f1f2">@L["F1 ve F2 Testi"]</a></li>
                        <li><a class="dropdown-item" href="ttest">@L["T-Test Analizi"]</a></li>
                        <li><a class="dropdown-item" href="ldcalc">@L["LD Hesabı"]</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="anova">@L["Tek Yönlü ANOVA"]</a></li>
                        <li><a class="dropdown-item" href="regression">@L["Çoklu Regresyon"]</a></li>
                        <li><a class="dropdown-item" href="calibration">@L["Kalibrasyon Eğrisi"]</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown me-3">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @L["Rehberler"]
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="about-kinetic-analysis">@L["Kinetik Analiz Rehberi"]</a></li>
                        <li><a class="dropdown-item" href="about-ternary-phase-diagram">@L["Üçgen Faz Diyagramı Rehberi"]</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link me-3" href="about">@L["Hakkında"]</a>
                </li>
                <li class="nav-item">
                    <a href="contact" class="nav-link me-3">@L["İletişim"]</a>
                </li>
            </ul>
            <!-- Sağ taraf: tema, dil -->
            <div class="d-flex align-items-center gap-3">
                <ThemeToggle />
                <div class="lang-switch" role="group" aria-label="@L["Dil"]">
                    <button type="button" class="lang-btn @(IsEnglish ? "" : "active")" @onclick='() => SetCulture("tr-TR")' title="Türkçe">TR</button>
                    <span class="lang-sep" aria-hidden="true">|</span>
                    <button type="button" class="lang-btn @(IsEnglish ? "active" : "")" @onclick='() => SetCulture("en-US")' title="English">EN</button>
                </div>
            </div>
        </div>
    </div>
</nav>

@code {
    [CascadingParameter] public SiteProfile Site { get; set; } = SiteProfiles.Tr;

    private static bool IsEnglish => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";

    /// <summary>
    /// Dil çerezini sunucu uç noktası yazar ve aynı sayfaya geri döner. Blazor Server devresinin kültürü
    /// bağlantı kurulurken belirlendiği için tam sayfa yüklemesi zorunludur (forceLoad).
    /// </summary>
    private void SetCulture(string culture)
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var url = $"culture/set?c={Uri.EscapeDataString(culture)}&r={Uri.EscapeDataString(current)}";
        Nav.NavigateTo(url, forceLoad: true);
    }

    private bool _isInitialized = false;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/NavMenu.razor.js");
                await JS.InvokeVoidAsync("initializeScrollEffect");
                _isInitialized = true;
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"JavaScript modülü yüklenirken bir hata oluştu: {ex.Message}");
            }
        }
    }
}

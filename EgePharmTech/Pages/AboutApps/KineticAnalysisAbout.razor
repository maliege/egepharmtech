                    <tr><th scope="row">Gompertz</th><td>a = 3,14 · b = 2,44</td><td>0,978</td><td>65,7</td><td>0,002</td><td>4,2</td><td>12,2</td><td>Kuyrukta +5,7 / +7,3 artık.</td></tr>

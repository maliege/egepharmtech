@page "/Error"
@using System.Globalization
@model EgePharmTech.Pages.ErrorModel
@{
    // Üretimde yakalanmayan istisna için UseExceptionHandler("/Error") bu sayfayı yeniden çalıştırır.
    // Razor Page olarak tutulur: Blazor devresine ya da prerender'a bağımlı değildir, o katman hata
    // verirken de güvenle çalışır. Dil kültürden (alan adı ya da çerez) gelir.
    var en = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    Layout = null;
}
<!DOCTYPE html>
<html lang="@(en ? "en" : "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0d9488" />
    <title>@(en ? "Error · EgePharmTech" : "Hata · EgePharmTech")</title>
    <link rel="icon" href="/img/egepharmtech/favicon.svg" type="image/svg+xml" />
    <style>
        :root { color-scheme: light dark; }
        body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
               font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; background: #f8fafc; color: #0f172a; }
        @@media (prefers-color-scheme: dark) { body { background: #0f172a; color: #e2e8f0; } .card { background: #1e293b; } }
        .card { max-width: 32rem; margin: 1rem; padding: 2rem; border-radius: 1rem; background: #fff; box-shadow: 0 10px 30px rgba(0,0,0,.08); text-align: center; }
        h1 { font-size: 1.25rem; margin: 0 0 .5rem; }
        p { margin: .25rem 0; line-height: 1.5; }
        a.btn { display: inline-block; margin-top: 1.5rem; padding: .6rem 1.4rem; border-radius: .5rem; background: #0d9488; color: #fff; text-decoration: none; }
        a.btn:hover { background: #0f766e; }
        code { font-size: .8rem; opacity: .7; }
    </style>
</head>
<body>
    <main class="card">
        <h1>@(en ? "Something went wrong" : "Bir hata oluştu")</h1>
        <p>@(en ? "The request could not be completed. Your data stays in your browser; please go back and try again."
                : "İstek tamamlanamadı. Verileriniz tarayıcınızda durur; geri dönüp yeniden deneyin.")</p>
        @if (Model.ShowRequestId)
        {
            <p><code>Request ID: @Model.RequestId</code></p>
        }
        <a class="btn" href="/">@(en ? "Home" : "Anasayfa")</a>
    </main>
</body>
</html>

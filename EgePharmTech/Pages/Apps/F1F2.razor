@using System.Text.Json
@using EgePharmTech.Helpers
@using Microsoft.JSInterop
@using EgePharmTech.Middleware
@using EgePharmTech.Core.Dissolution
@using EgePharmTech.Components.UI

@page "/f1f2"
<SiteTitle Text="F1 / F2 Analizi" />
@inject AnalysisStateF1F2 State
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<section class="container-fluid p-4">
<h5 class="mb-3 text-primary fw-bold"><i class="bi bi-graph-up me-2"></i>@L["F1 / F2 Analizi — Çözünme Profili Karşılaştırması"]</h5>

<div class="hot-grid" style="display:grid; grid-template-columns: 1fr; gap: 16px;">
  <div>
  <h5>@L["Referans"]</h5>
      <HandsontableGrid @ref="_hotReference"
                        Data="State.Reference"
                        Columns="_columns"
                        Height="420"
                        MinRows="16" />
    </div>

    <div>
    <h5>@L["Test Ürünü"]</h5>
      <HandsontableGrid @ref="_hotProduct"
                        Data="State.Product"
                        Columns="_columns"
                        Height="420"
                        MinRows="16" />
    </div>
  </div>

  <div style="margin-top:12px; display:flex; gap:12px; align-items:center;">
    <button class="btn btn-primary" @onclick="ComputeAsync">@L["Hesapla"]</button>
  </div>

  <div class="mt-2 d-flex gap-4 align-items-center flex-wrap">
    <label class="form-check">
      <input class="form-check-input" type="checkbox" @bind="_require12Replicates" />
      <span class="form-check-label">@L["12 tekrar zorunlu"]</span>
    </label>
    <label class="form-check">
      <input class="form-check-input" type="checkbox" @bind="_enable85Cutoff" />
      <span class="form-check-label">@L["%85 kesme kuralı"]</span>
    </label>
  </div>

  @* Kullanım rehberi (TR/EN) ayrı bileşende: Components/Guides/F1F2Guide.razor *@
  <F1F2Guide />

  <div class="mt-3">
    <h5>@L["Grafik"]</h5>
    <div style="max-width: 800px; margin: 0 auto;">
      <canvas id="@_chartId" style="width:100%; height:420px;"></canvas>
    </div>
  </div>

  @if (_f1 is not null || _f2 is not null)
  {
    <div class="mt-3 p-3 border rounded bg-light">
      <h5 class="mb-2">@L["Rapor"]</h5>

      @if (_uyarilar.Count > 0)
      {
        <div class="alert alert-warning small py-2 mb-3">
          <strong><i class="bi bi-exclamation-triangle me-1"></i>@L["Dikkat edilmesi gerekenler"]</strong>
          <ul class="mb-0 mt-1">
            @foreach (var uyari in _uyarilar)
            {
              <li>@uyari</li>
            }
          </ul>
          <div class="mt-2">
            @L["Bu uyarılar hesabı durdurmaz; aşağıdaki f1/f2 değerleri yine de hesaplanmıştır. Koşulların sağlanıp sağlanmadığına karar vermek kullanıcıya aittir."]
          </div>
        </div>
      }
      <div><strong>f1:</strong> @(_f1?.ToString("0.##") ?? "-")</div>
      <div><strong>f2:</strong> @(_f2?.ToString("0.##") ?? "-")</div>

      @if (!string.IsNullOrWhiteSpace(_chartError))
      {
        <div class="mt-2 text-danger"><strong>@L["Grafik"]:</strong> @_chartError</div>
      }

      @if (_reportN is not null)
      {
        <hr />
        @if (_reportCutoffTime is not null)
        {
          <div><strong>@L["%85 kesme zamanı"]:</strong> @_reportCutoffTime?.ToString("0.###")</div>
          <div class="text-muted" style="font-size:0.9em">@_reportCutoffRule</div>
        }
        @if (_reportNAll is not null)
        {
          <div><strong>@L["n (kesme öncesi)"]:</strong> @_reportNAll</div>
          <div><strong>@L["Kesme indeksi"]:</strong> @(_reportCutoffIndex?.ToString() ?? "-")</div>
        }
        <div><strong>@L["n (ortak zaman noktası)"]:</strong> @_reportN</div>
        <div><strong>@L["Zaman noktaları"]:</strong> @(_reportTimesCsv ?? "-")</div>
        <div><strong>ΣR:</strong> @(_reportSumR?.ToString("0.####") ?? "-")</div>
        <div><strong>Σ|R−T|:</strong> @(_reportSumAbsDiff?.ToString("0.####") ?? "-")</div>
        <div><strong>Σ(R−T)²:</strong> @(_reportSumSqDiff?.ToString("0.####") ?? "-")</div>

        <hr />
        <div><strong>@L["Referans ortalaması"]:</strong> @(_reportRefMean?.ToString("0.##") ?? "-")</div>
        <div><strong>@L["Referans std. sapma"]:</strong> @(_reportRefStdDev?.ToString("0.##") ?? "-")</div>
        <div><strong>@L["Test ürünü ortalaması"]:</strong> @(_reportProdMean?.ToString("0.##") ?? "-")</div>
        <div><strong>@L["Test ürünü std. sapma"]:</strong> @(_reportProdStdDev?.ToString("0.##") ?? "-")</div>
      }
    </div>
  }

</section>


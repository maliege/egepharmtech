            new() { Title = T("Tekrar") + " 3", Data = "Rep3", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 4", Data = "Rep4", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 5", Data = "Rep5", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 6", Data = "Rep6", Type = "numeric", Width = 70, NumericFormat = "0.00" },

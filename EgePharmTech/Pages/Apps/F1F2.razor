    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
#if DEBUG
        if (!_debugSeeded && !_debugSeedInProgress)
            await TryDebugSeedAsync();
#endif
    }

#if DEBUG
    private async Task TryDebugSeedAsync()
    {
        if (_debugSeeded) return;
        if (_debugSeedInProgress) return;

        _debugSeedInProgress = true;
        try
        {
            // Handsontable initializes after first render; refs may exist but not be ready.
            // Retry a few times to ensure both grids are alive.
            const int maxAttempts = 10;
            for (; _debugSeedAttempts < maxAttempts; _debugSeedAttempts++)
            {
                if (_hotReference is null || _hotProduct is null)
                {
                    await Task.Delay(150);
                    continue;
                }

                var refReady = await IsGridReadyAsync(_hotReference);
                var prodReady = await IsGridReadyAsync(_hotProduct);
                if (!refReady || !prodReady)
                {
                    await Task.Delay(150);
                    continue;
                }

                ApplyTsvToMatrix(State.Reference, _debugReferenceTsv);
                ApplyTsvToMatrix(State.Product, _debugProductTsv);

                await _hotReference.UpdateDataAsync(State.Reference);
                await _hotProduct.UpdateDataAsync(State.Product);

                _debugSeeded = true;
                StateHasChanged();
                return;
            }
        }
        finally
        {
            _debugSeedInProgress = false;
        }
    }

    private static async Task<bool> IsGridReadyAsync(HandsontableGrid grid)
    {
        try
        {
            _ = await grid.GetDataAsync();
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static void ApplyTsvToMatrix(object?[][] target, string tsv)
    {
        if (target.Length == 0) return;

        var lines = tsv
            .Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .Where(l => l.Length > 0)
            .ToArray();

        var rowsToWrite = Math.Min(lines.Length, target.Length);
        for (var row = 0; row < rowsToWrite; row++)
        {
            var parts = lines[row].Split('\t');
            if (parts.Length == 0) continue;

            // Ensure row has 16 columns as expected by the grid/state
            if (target[row] is null || target[row].Length < 16)
                target[row] = new object?[16];

            // Time (col 0)
            if (NumericCellParser.TryParse(parts[0], out var time))
            {
                target[row][0] = time;
            }

            // Rep1..Rep12 (cols 1..12) from parts[1..12]
            for (var i = 1; i <= 12; i++)
            {
                var partIndex = i;
                if (partIndex >= parts.Length) break;

                if (NumericCellParser.TryParse(parts[partIndex], out var v))
                {
                    target[row][i] = v;
                }
                else
                {
                    target[row][i] = null;
                }
            }

            // Clear Mean/StdDev/Extra; they will be recalculated
            target[row][13] = null;
            target[row][14] = null;
            target[row][15] = null;
        }
    }
#endif

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("chartHelper.destroyChart", _chartId);
        }
        catch
        {
            // ignore dispose-time JS errors
        }
    }

    private async Task RenderChartAsync(
        IReadOnlyList<(double t, double yMean)> referenceSeries,
        IReadOnlyList<(double t, double yMean)> productSeries)
    {
        // Use union of timepoints for the graph; missing values become null (Chart.js breaks the line).
        var rMap = referenceSeries
            .GroupBy(x => x.t)
            .ToDictionary(g => g.Key, g => g.Last().yMean);

        var pMap = productSeries
            .GroupBy(x => x.t)
            .ToDictionary(g => g.Key, g => g.Last().yMean);

        var times = rMap.Keys.Union(pMap.Keys).OrderBy(x => x).ToArray();
        var labels = times
            .Select(t => t.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))
            .ToArray();

        double?[] r = times.Select(t => rMap.TryGetValue(t, out var v) ? v : (double?)null).ToArray();
        double?[] p = times.Select(t => pMap.TryGetValue(t, out var v) ? v : (double?)null).ToArray();

        var chartLabels = new
        {
            reference = L["Referans (%)"].Value,
            product = L["Test ürünü (%)"].Value,
            x = L["Zaman"].Value,
            y = L["Salım (%)"].Value
        };
        await JS.InvokeVoidAsync(
            "chartHelper.createReleaseComparisonChart",
            _chartId,
            labels,
            r,
            p,
            L["Referans – Test ürünü (dissolüsyon profili)"].Value,
            chartLabels);
    }

    // Hizalama, %85 kesmesi, f1/f2 ve ortalama/SS hesapları EgePharmTech.Core.Dissolution.SimilarityFactors'a
    // taşındı (testleri: SimilarityFactorsTests). Sayfa yalnız veri okuma ve sunum yapar.

    // Sütun başlıkları arayüz dilinden gelir; L enjeksiyonu alan başlatıcısından sonra
    // geldiği için liste OnInitialized'da kurulur.
    private List<HandsontableGrid.ColumnConfig> _columns = [];

    protected override void OnInitialized()

    private static List<object[]> CalculateMeanStdChanges(object?[][] table)
    {
        var changes = new List<object[]>();
        
        for (int rowIdx = 0; rowIdx < table.Length; rowIdx++)
        {
            var r = table[rowIdx];
            if (r is null || r.Length < 15) continue;

            var reps = new List<double>();
            for (int c = 1; c <= 12 && c < r.Length; c++)
                if (TryGetDouble(r[c], out var v))
                    reps.Add(v);

            if (reps.Count == 0) continue;

            var mean = reps.Average();
            var std = reps.Count > 1 
                ? Math.Sqrt(reps.Select(x => Math.Pow(x - mean, 2)).Sum() / (reps.Count - 1))
                : 0;
            var rsd = mean != 0 ? (std / mean) * 100 : 0;

            changes.Add([rowIdx, 13, Math.Round(mean, 2)]);
            changes.Add([rowIdx, 14, Math.Round(std, 2)]);
            changes.Add([rowIdx, 15, Math.Round(rsd, 2)]);
        }
        
        return changes;
    }

    private static bool TryGetDouble(object? o, out double v)
    {
        v = default;
        if (o is null) return false;
        if (o is double d) { v = d; return true; }
        if (o is float f)  { v = f; return true; }
        if (o is int i)    { v = i; return true; }
        if (o is long l)   { v = l; return true; }

        var s = o.ToString();
        return NumericCellParser.TryParse(s, out v);
    }

    /// <summary>
    /// Bir profilin tarama sonucu: analize giren seri, her zaman noktasinin RSD'si
    /// ve ANALIZ DISI birakilan satirlar. Elemeler eskiden sessizce yapiliyordu;
    /// kullanici bekledigi zaman noktalarindan daha azi ile hesaplanmis bir f2'yi
    /// fark edemiyordu. Artik hepsi rapora uyari olarak yansiyor.
    /// </summary>
    private sealed class ProfilTarama
    {
        public List<(double t, double yMean)> Seri { get; } = new();
        public Dictionary<double, double> Rsd { get; } = new();
        public List<(double t, int adet)> TekrarEksik { get; } = new();
        public List<(double t, double ortalama)> AralikDisi { get; } = new();
    }

    private ProfilTarama TaraProfil(object?[][] table)
    {
        var tarama = new ProfilTarama();

        foreach (var r in table)
        {
            if (r is null || r.Length < 13) continue;
            if (!TryGetDouble(r[0], out var t)) continue;
            if (t <= 0) continue; // t=0 kilavuz geregi profil karsilastirmasina girmez

            var reps = new List<double>(12);
            for (int c = 1; c <= 12 && c < r.Length; c++)
                if (TryGetDouble(r[c], out var v))
                    reps.Add(v);

            if (reps.Count == 0) continue; // tamamen bos satir; uyari uretmeye deger degil

            if (_require12Replicates && reps.Count != 12)
            {
                tarama.TekrarEksik.Add((t, reps.Count));
                continue;
            }

            var mean = reps.Average();
            if (mean <= 0 || mean >= 100)
            {
                tarama.AralikDisi.Add((t, mean));
                continue;
            }

            var sd = reps.Count > 1
                ? Math.Sqrt(reps.Sum(x => Math.Pow(x - mean, 2)) / (reps.Count - 1))
                : 0d;
            tarama.Rsd[t] = mean != 0 ? 100d * sd / mean : 0d;

            tarama.Seri.Add((t, mean));
        }

        return tarama;
    }

    private async Task ComputeAsync()
    {
        if (_hotProduct is null || _hotReference is null) return;

        _chartError = null;

        var referenceObj = await _hotReference.GetDataAsync();
        var productObj = await _hotProduct.GetDataAsync();

        var reference = ConvertJsonToArray(referenceObj);
        var product = ConvertJsonToArray(productObj);

        var referenceChanges = CalculateMeanStdChanges(reference);
        var productChanges = CalculateMeanStdChanges(product);
        
        if (referenceChanges.Count > 0)
            await _hotReference.SetCellsAsync(referenceChanges);
        if (productChanges.Count > 0)
            await _hotProduct.SetCellsAsync(productChanges);

        var refTarama = TaraProfil(reference);
        var prodTarama = TaraProfil(product);
        var referenceSeries = refTarama.Seri;
        var productSeries = prodTarama.Seri;

        _referenceTime = referenceSeries.Select(s => s.t).ToArray();
        _referenceY = referenceSeries.Select(s => s.yMean).ToArray();
        _productTime = productSeries.Select(s => s.t).ToArray();
        _productY = productSeries.Select(s => s.yMean).ToArray();

        var (tAll, rAll, pAll) = SimilarityFactors.AlignByExactTimepoints(referenceSeries, productSeries);

        double[] t;
        double[] r;
        double[] p;

        if (_enable85Cutoff)
        {
            // %85 rule (mode 1): stop at first time where (R>=85 OR P>=85), include that timepoint.
            var cutoffIndex = SimilarityFactors.FindCutoffIndex(rAll, pAll, 85d);
            (t, r, p) = SimilarityFactors.TakeThrough(tAll, rAll, pAll, cutoffIndex);
            _reportCutoffRule = L["Kural: referans veya test ürününden biri %85'e ulaştığı ilk zaman noktasında durulur, o nokta dahil edilir."].Value;
            _reportCutoffTime = t.Length > 0 ? t[^1] : null;
            _reportNAll = tAll.Length;
            _reportCutoffIndex = cutoffIndex;
        }
        else
        {
            t = tAll;
            r = rAll;
            p = pAll;
            _reportCutoffRule = L["Kural: %85 kesme kuralı kapalı."].Value;
            _reportCutoffTime = null;
            _reportNAll = tAll.Length;
            _reportCutoffIndex = null;
        }

        var (f1, sumR, sumAbsDiff) = SimilarityFactors.F1(r, p);
        _f1 = f1;
        _f2 = SimilarityFactors.F2(r, p);

        _reportN = t.Length;
        _reportTimesCsv = t.Length == 0
            ? null
            : string.Join(", ", t.Select(x => x.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)));

        _reportSumR = sumR;
        _reportSumAbsDiff = sumAbsDiff;
        _reportSumSqDiff = r.Zip(p, (rr, pp) => (rr - pp) * (rr - pp)).Sum();

        UyarilariUret(refTarama, prodTarama, t);

        var (refMean, refStd) = SimilarityFactors.MeanStdDev(r);
        var (prodMean, prodStd) = SimilarityFactors.MeanStdDev(p);
        _reportRefMean = refMean;
        _reportRefStdDev = refStd;
        _reportProdMean = prodMean;
        _reportProdStdDev = prodStd;

        try
        {
            await RenderChartAsync(referenceSeries, productSeries);
        }
        catch (JSException ex)
        {
            _chartError = ex.Message;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Kilavuzlarin aradigi kosullar ile uygulamanin sessiz elemelerini kullaniciya
    /// gorunur kilar. Uygulama bu kosullari ZORUNLU TUTMAZ; hesap yine yapilir,
    /// burada yalnizca bildirilir. Amac, kosullar saglanmadigi halde "gecerli
    /// gorunen" bir f2'nin fark edilmeden kullanilmasini onlemek.
    /// </summary>
    private void UyarilariUret(ProfilTarama referans, ProfilTarama test, double[] kullanilanZamanlar)
    {
        _uyarilar.Clear();

        void Eleme(ProfilTarama tarama, string ad)
        {
            if (tarama.TekrarEksik.Count > 0)
            {
                var liste = string.Join(", ", tarama.TekrarEksik
                    .Select(x => L["t={0} ({1} tekrar)", Bicim(x.t), x.adet].Value));
                _uyarilar.Add(L["{0}: \"12 tekrar zorunlu\" seçeneği açık olduğu için şu zaman noktaları analiz dışı bırakıldı — {1}.", ad, liste].Value);
            }

            if (tarama.AralikDisi.Count > 0)
            {
                var liste = string.Join(", ", tarama.AralikDisi
                    .Select(x => L["t={0} (ortalama {1})", Bicim(x.t), x.ortalama.ToString("0.##")].Value));
                _uyarilar.Add(L["{0}: ortalaması %100'e ulaştığı ya da sıfır/negatif olduğu için şu zaman noktaları analiz dışı bırakıldı — {1}. Profil tam çözünmeye ulaşıyorsa plato noktalarının düştüğünü unutmayın.", ad, liste].Value);
            }
        }

        Eleme(referans, L["Referans"].Value);
        Eleme(test, L["Test ürünü"].Value);

        // Kesme sonrasi nokta sayisi
        if (kullanilanZamanlar.Length > 0 && kullanilanZamanlar.Length < 3)
        {
            _uyarilar.Add(L["Hesaplamada yalnızca {0} ortak zaman noktası kullanıldı. f2 için genellikle en az 3 nokta aranır; bu değer güvenilir değildir.", kullanilanZamanlar.Length].Value);
        }

        // RSD sinirlari: ilk noktada %20, sonrakilerde %10
        for (var i = 0; i < kullanilanZamanlar.Length; i++)
        {
            var zaman = kullanilanZamanlar[i];
            var sinir = i == 0 ? 20d : 10d;

            foreach (var (tarama, ad) in new[] { (referans, L["Referans"].Value), (test, L["Test ürünü"].Value) })
            {
                if (!tarama.Rsd.TryGetValue(zaman, out var rsd)) continue;
                if (rsd > sinir)
                {
                    // "ilk" / "sonraki" tek kelimeyle çevrilemez; iki ayrı cümle anahtarı.
                    var rsdMetin = rsd.ToString("0.0");
                    var sinirMetin = sinir.ToString("0");
                    _uyarilar.Add(i == 0
                        ? L["{0}: t={1} noktasında RSD %{2} — ilk zaman noktaları için sınır %{3}.", ad, Bicim(zaman), rsdMetin, sinirMetin].Value
                        : L["{0}: t={1} noktasında RSD %{2} — sonraki zaman noktaları için sınır %{3}.", ad, Bicim(zaman), rsdMetin, sinirMetin].Value);
                }
            }
        }
    }

    private static string Bicim(double t)
        => t.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static object?[][] ConvertJsonToArray(object? data)
    {
        if (data is null) return Array.Empty<object?[]>();

        if (data is JsonElement jsonElement && jsonElement.ValueKind == JsonValueKind.Array)
        {
            var rows = new List<object?[]>();
            foreach (var row in jsonElement.EnumerateArray())
            {
                if (row.ValueKind == JsonValueKind.Array)
                {
                    var cells = new List<object?>();
                    foreach (var cell in row.EnumerateArray())
                    {
                        cells.Add(cell.ValueKind switch
                        {
                            JsonValueKind.Number => cell.GetDouble(),
                            JsonValueKind.String => cell.GetString(),
                            JsonValueKind.Null => null,
                            JsonValueKind.Undefined => null,
                            _ => cell.ToString()
                        });
                    }
                    rows.Add(cells.ToArray());
                }
            }
            return rows.ToArray();
        }

        if (data is object?[][] arr) return arr;

        return Array.Empty<object?[]>();
    }
}

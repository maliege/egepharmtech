@using System.Text.Json
@using Microsoft.JSInterop
@using EgePharmTech.Middleware
@using EgePharmTech.Core.Dissolution
@using EgePharmTech.Components.UI

@page "/kinetik"
<SiteTitle Text="Kinetik Analiz" />
@inject AnalysisState State
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="container-fluid px-4" style="margin-top: 70px;">
    <h5 class="mb-3 text-primary fw-bold"><i class="bi bi-activity me-2"></i>@L["Kinetik Analiz"]</h5>

    <div class="row">
        <div class="col-md-6 d-flex">
            <div class="card shadow-sm mb-4 flex-fill">
                <div class="card-header bg-dark">
                    <span class="fw-semibold text-white"><i class="bi bi-table me-2"></i>@L["Veri Girişi"]</span>
                </div>
                <div class="card-body p-2">
                    <HandsontableGrid @ref="_hotInvitro"
                                      Data="State.Invitro"
                                      Columns="_columns"
                                      Height="350"
                                      MinRows="50" />
                </div>
                <div class="card-footer">
                    <div class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label mb-1 small">@L["Hopfenberg geometrisi"]</label>
                            <select class="form-select form-select-sm" @bind="_geometry" style="width:150px;">
                                <option value="@HopfenbergGeometry.Slab">Slab (n=1)</option>
                                <option value="@HopfenbergGeometry.Cylinder">@L["Silindir (n=2)"]</option>
                                <option value="@HopfenbergGeometry.Sphere">@L["Küre (n=3)"]</option>
                                <option value="@HopfenbergGeometry.HalfSphere">@L["Yarım küre (n=1,5)"]</option>
                                <option value="@HopfenbergGeometry.Triangle">@L["Üçgen (n=4)"]</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label mb-1 small">@L["Varyantlar"]</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="vTlag" @bind="_useTlag" />
                                    <label class="form-check-label small" for="vTlag">Tlag</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="vF0" @bind="_useF0" />
                                    <label class="form-check-label small" for="vF0">F0</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="vFmax" @bind="_useFmax" />
                                    <label class="form-check-label small" for="vFmax">Fmax</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="form-check" title="@L["Costa & Sousa Lobo: n yalnız F<%60 bölgesinden belirlenmelidir"]">
                                <input class="form-check-input" type="checkbox" id="kpAll" @bind="_kpUseAllPoints" />
                                <label class="form-check-label small" for="kpAll">@L["KP: tüm noktalar"]</label>
                            </div>
                        </div>
                        <div class="col-auto ms-auto">
                            <button class="btn btn-success btn-sm" @onclick="ComputeAsync">
                                <i class="bi bi-calculator me-1"></i>@L["Analiz Et"]
                            </button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        @L["Varyantlar yalnız modelin desteklediği yerde uygulanır (şartname §7)."]
                    </small>

                    @* Model seçimi: araştırmacı çoğu zaman belli birkaç modeli karşılaştırır. Seçilmeyen model
                       hiç fit edilmez; Akaike ağırlıkları yalnız seçilenler arasında dağılır. Seçim AnalysisState'te
                       tutulur, sayfadan çıkıp dönünce korunur. *@
                    <div class="mt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _modelPickerOpen = !_modelPickerOpen"
                                aria-expanded="@(_modelPickerOpen ? "true" : "false")" aria-controls="modelPicker">
                            <i class="bi bi-list-check me-1"></i>@L["Modeller"]: @SelectedModels.Count/@_allModels.Count
                            <i class="bi @(_modelPickerOpen ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i>
                        </button>
                        @if (_modelPickerOpen)
                        {
                            <div id="modelPicker" class="border rounded p-2 mt-2">
                                <div class="d-flex flex-wrap gap-3 mb-2 small">
                                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="SelectAllModels">@L["Tümü"]</button>
                                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="SelectNoModels">@L["Hiçbiri"]</button>
                                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="SelectClassicModels"
                                            title="@L["Zero-order, First-order, Higuchi, Hixson-Crowell, Korsmeyer-Peppas"]">@L["Klasik beşli"]</button>
                                </div>
                                <div class="row g-1">
                                    @foreach (var name in _allModels)
                                    {
                                        var id = "m_" + name.Replace(' ', '_').Replace('(', '_').Replace(')', '_');
                                        <div class="col-6 col-md-4 col-lg-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="@id"
                                                       checked="@SelectedModels.Contains(name)"
                                                       @onchange="e => ToggleModel(name, e.Value is true)" />
                                                <label class="form-check-label small" for="@id">@name</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <small class="text-muted d-block mt-1">
                                    @L["Seçilmeyen modeller fit edilmez; AIC ağırlıkları yalnız seçilen modeller arasında hesaplanır."]
                                </small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 d-flex">
            <div class="card shadow-sm mb-4 flex-fill">
                <div class="card-header bg-primary">
                    <span class="fw-semibold text-white"><i class="bi bi-graph-up me-2"></i>@L["Zaman - Salım Grafiği"]</span>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:350px;">
                    @if (_showChart)
                    {
                        <canvas id="releaseChart" style="width:100%; height:350px;"></canvas>
                    }
                    else
                    {
                        <span class="text-muted"><i class="bi bi-info-circle me-2"></i>@L["Analiz sonrası grafik burada görünecek"]</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Kullanım rehberi (TR/EN) ayrı bileşende: Components/Guides/KinetikGuide.razor *@
    <KinetikGuide />

    @* Veri okuma uyarıları: atlanan satırlar, Ortalama sütununa düşme, %100 üstü değerler,
       kesir ölçeği şüphesi, kalan→salım çevrimi. Hiç nokta kalmadıysa hata olarak gösterilir. *@
    @if (_uyarilar.Count > 0)
    {
        <div class="alert @(_dataCount == 0 ? "alert-danger" : "alert-warning") mb-4" role="alert" style="font-size:0.9rem;">
            <div class="fw-semibold mb-1">
                <i class="bi bi-exclamation-triangle me-1"></i>
                @L[_dataCount == 0 ? "Analiz yapılamadı" : "Veri okunurken dikkat edilmesi gerekenler"]
            </div>
            <ul class="mb-0 ps-3">
                @foreach (var u in _uyarilar)
                {
                    <li>@u</li>
                }
            </ul>
        </div>
    }

    @if (_result is not null && (_result.Fits.Count > 0 || _result.MechanismFits.Count > 0))
    {
        <!-- Profil özeti (model-bağımsız) -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary">
                <span class="fw-semibold text-white"><i class="bi bi-clipboard-data me-2"></i>@L["Profil Özeti (model-bağımsız)"]</span>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col">
                        <div class="text-muted small">AUC</div>
                        <div class="fs-5 fw-semibold">@_result.Profile.Auc.ToString("0.##")</div>
                        <div class="text-muted small">@L["%·zaman"]</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">@L["Dissolüsyon Etkinliği (DE)"]</div>
                        <div class="fs-5 fw-semibold">@_result.Profile.De.ToString("0.##") %</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">@L["Ortalama Dissolüsyon Süresi (MDT)"]</div>
                        <div class="fs-5 fw-semibold">@_result.Profile.Mdt.ToString("0.##")</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">@L["Son nokta"]</div>
                        <div class="fs-5 fw-semibold">@_result.Profile.FLast.ToString("0.##") %</div>
                        <div class="text-muted small">t = @_result.Profile.TLast.ToString("0.##")</div>
                    </div>
                </div>
                <small class="text-muted d-block mt-2">
                    @L["Costa & Sousa Lobo (2001), Eq. 41 (DE) ve Eq. 42 (MDT). Hiçbir modele fit gerektirmez."]
                </small>
            </div>
        </div>

        <!-- Model sıralaması -->
        @if (_result.Fits.Count > 0)
        {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark">
                <span class="fw-semibold text-white">
                    <i class="bi bi-list-ol me-2"></i>@L["Model Sıralaması (AIC'e göre — küçük daha iyi)"] — @_dataCount @L["veri noktası"]
                </span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-sm table-bordered table-hover" style="font-size:0.85rem; cursor:pointer;">
                        <thead class="table-dark">
                            <tr>
                                <th>Model</th>
                                <th>@L["Katsayılar"]</th>
                                <th class="text-end">R²<sub>adj</sub></th>
                                <th class="text-end">AIC</th>
                                <th class="text-end">MSC</th>
                                <th class="text-end">@L["Ağırlık"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in _result.Fits)
                            {
                                var isSelected = _selectedFit?.ModelName == f.ModelName;
                                var isBest = f == _result.Fits[0];
                                var rowClass = isSelected ? "table-primary" : (isBest ? "table-success" : "");
                                <tr class="@rowClass" @onclick="() => SelectModelAsync(f)" title="@L["Tahmini salım grafiği için tıklayın"]">
                                    <td>
                                        <strong>@f.ModelName</strong>
                                        @if (isSelected) { <i class="bi bi-graph-up-arrow ms-1 text-primary"></i> }
                                        @if (!f.Converged) { <i class="bi bi-exclamation-triangle ms-1 text-warning" title="@L["Yakınsama başarısız — tohum değerleri gösteriliyor"]"></i> }
                                    </td>
                                    <td><code>@f.CoefficientSummary</code></td>
                                    <td class="text-end">@f.Gof.RsqrAdj.ToString("0.0000")</td>
                                    <td class="text-end">@f.Gof.Aic.ToString("0.00")</td>
                                    <td class="text-end">@f.Gof.Msc.ToString("0.000")</td>
                                    <td class="text-end">
                                        @(_result.AkaikeWeights.TryGetValue(f.ModelName, out var w) ? (w * 100).ToString("0.0") + "%" : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <small class="text-muted">
                    @if (Lang.IsEn)
                    {
                        <strong>Ranking is by AIC</strong><text> (spec §1.5): raw SS/R² does not penalise the number of
                        parameters and therefore unduly favours more complex models.</text>
                        <strong>Weight</strong><text> = Akaike weight (relative probability that the model is the best).
                        All criteria are computed in F(%) space over the same @_dataCount points.</text>
                    }
                    else
                    {
                        <strong>Sıralama AIC ile yapılır</strong><text> (şartname §1.5): ham SS/R² parametre sayısını
                        cezalandırmadığı için daha karmaşık modelleri haksız yere öne çıkarır.</text>
                        <strong>Ağırlık</strong><text> = Akaike ağırlığı (modelin en iyi olma göreli olasılığı).
                        Tüm ölçütler F(%)-uzayında ve aynı @_dataCount noktası üzerinden hesaplanır.</text>
                    }
                </small>
            </div>
        </div>
        }

        <!-- Kısıtlı veri kümesine fit edilen modeller (sıralamaya girmez) -->
        @if (_result.MechanismFits.Count > 0)
        {
            <div class="card shadow-sm mb-4 border-warning">
                <div class="card-header bg-warning">
                    <span class="fw-semibold text-dark">
                        <i class="bi bi-diagram-3 me-2"></i>@L["Mekanizma Analizi (kısıtlı veri kümesi — sıralamaya girmez)"]
                    </span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover" style="font-size:0.85rem; cursor:pointer;">
                            <thead class="table-light">
                                <tr>
                                    <th>Model</th>
                                    <th>@L["Katsayılar"]</th>
                                    <th class="text-end">N</th>
                                    <th class="text-end">R²<sub>adj</sub></th>
                                    <th class="text-end">SS</th>
                                    <th>@L["Yorum"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in _result.MechanismFits)
                                {
                                    <tr class="@(_selectedFit?.ModelName == f.ModelName ? "table-primary" : "")"
                                        @onclick="() => SelectModelAsync(f)">
                                        <td><strong>@f.ModelName</strong></td>
                                        <td><code>@f.CoefficientSummary</code></td>
                                        <td class="text-end">@f.Gof.N</td>
                                        <td class="text-end">@f.Gof.RsqrAdj.ToString("0.0000")</td>
                                        <td class="text-end">@f.Gof.SS.ToString("0.###")</td>
                                        <td class="small">@string.Join(" ", f.Flags)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <small class="text-muted">
                        @if (Lang.IsEn)
                        {
                            <text>Following Costa &amp; Sousa Lobo, Korsmeyer–Peppas is fitted only to the</text> <strong>F ≤ 60 %</strong>
                            <text> region, i.e. it uses a </text><strong>different data set</strong><text> from the models above. Because
                            AIC = N·ln(SS) + 2p, AIC values of models with different N cannot be compared — hence the
                            separate table. KP answers not "which model describes the profile best?" but </text><strong>"what is the release mechanism in the early phase?"</strong><text> To include it in the ranking, tick </text><em>"KP: all points"</em><text>.</text>
                        }
                        else
                        {
                            <text>Korsmeyer-Peppas, Costa &amp; Sousa Lobo uyarınca yalnız </text><strong>F ≤ %60</strong><text> bölgesine fit edilir; yani yukarıdaki modellerden </text><strong>farklı bir veri kümesi</strong><text> kullanır. AIC = N·ln(SS) + 2p olduğu için farklı N'li modellerin AIC'i
                            karşılaştırılamaz — bu yüzden burada ayrı sunulur. KP "profili en iyi hangi model
                            anlatır?" sorusunun değil, </text><strong>"erken fazda salım mekanizması nedir?"</strong><text> sorusunun cevabıdır. Sıralamaya dahil etmek isterseniz </text><em>"KP: tüm noktalar"</em><text> kutusunu işaretleyin.</text>
                        }
                    </small>
                </div>
            </div>
        }

        <!-- Seçili model detayı -->
        @if (_selectedFit is not null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info">
                    <span class="fw-semibold text-white">
                        <i class="bi bi-info-circle me-2"></i>@_selectedFit.ModelName — <code class="text-white">@_selectedFit.Equation</code>
                    </span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="small text-muted">@L["Katsayılar"]</h6>
                            <table class="table table-sm table-bordered" style="font-size:0.82rem;">
                                <thead class="table-light">
                                    <tr><th>@L["Sembol"]</th><th class="text-end">@L["Değer"]</th><th>@L["Birim"]</th><th>@L["Açıklama"]</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in _selectedFit.Parameters)
                                    {
                                        <tr>
                                            <td><strong>@c.Symbol</strong></td>
                                            <td class="text-end">@c.Value.ToString("G6")</td>
                                            <td class="text-muted">@c.Unit</td>
                                            <td class="text-muted">@c.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6 class="small text-muted">@L["İkincil Parametreler"]</h6>
                            <table class="table table-sm table-bordered" style="font-size:0.82rem;">
                                <thead class="table-light">
                                    <tr><th>@L["Hedef"]</th><th class="text-end">@L["Süre"]</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in _selectedFit.Secondary)
                                    {
                                        <tr>
                                            <td><strong>@s.Symbol</strong></td>
                                            <td class="text-end">
                                                @if (s.IsCalculable)
                                                {
                                                    @s.Value!.Value.ToString("0.###")
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Non Calc</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="small text-muted">
                                N = @_selectedFit.Gof.N · DoF = @_selectedFit.Gof.Dof ·
                                SS = @_selectedFit.Gof.SS.ToString("0.###") ·
                                RMSE = @_selectedFit.Gof.RmsE.ToString("0.###") ·
                                R = @_selectedFit.Gof.R.ToString("0.0000")
                            </div>
                        </div>
                    </div>

                    @if (_selectedFit.Flags.Count > 0)
                    {
                        <div class="mt-2">
                            @foreach (var flag in _selectedFit.Flags)
                            {
                                var isWarn = flag.Contains("UYARI") || flag.Contains("NOT:") || flag.Contains("WARNING") || flag.Contains("NOTE:");
                                <div class="alert @(isWarn ? "alert-warning" : "alert-info") py-2 mb-2" style="font-size:0.82rem;">
                                    @flag
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Tahmini değerler -->
        @if (_estimateTable is not null && _estimateTable.Count > 0)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary">
                    <span class="fw-semibold text-white"><i class="bi bi-table me-2"></i>@L["Tahmini Salım Değerleri"]</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-sm table-bordered" style="font-size:0.80rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th>@L["Zaman"]</th>
                                    <th>@L["Gözlenen"]</th>
                                    @foreach (var f in AllFits)
                                    {
                                        <th class="text-center">@f.ModelName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _estimateTable)
                                {
                                    <tr>
                                        <td><strong>@row.Time.ToString("0.##")</strong></td>
                                        <td class="table-info">@row.Observed.ToString("0.##")</td>
                                        @foreach (var est in row.Estimates)
                                        {
                                            <td class="text-center">@est.ToString("0.##")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private HandsontableGrid? _hotInvitro;

    private AnalysisResult? _result;
    private ModelFit? _selectedFit;
    private int _dataCount;

    private double[]? _timeData;
    private double[]? _releaseData;
    private double[]? _predictedData;

    private bool _showChart;
    private bool _needsChartDraw;

    // Varyant / model seçenekleri (şartname §7 + Costa & Sousa Lobo)
    private HopfenbergGeometry _geometry = HopfenbergGeometry.Sphere;
    private bool _useTlag;
    private bool _useF0;
    private bool _useFmax;
    private bool _kpUseAllPoints;

    private IReadOnlyList<string> _uyarilar = [];

    private List<EstimateRow>? _estimateTable;
    private record EstimateRow(double Time, double Observed, double[] Estimates);

    private VariantOptions Options => new()
    {
        Geometry = _geometry,
        UseTlag = _useTlag,
        UseF0 = _useF0,
        UseFmax = _useFmax,
        KpUseAllPoints = _kpUseAllPoints,
        // Hepsi seçiliyse null (motor varsayılanı); aksi hâlde kopya küme.
        Models = SelectedModels.Count == _allModels.Count ? null : new HashSet<string>(SelectedModels, StringComparer.OrdinalIgnoreCase)
    };

    // ---- model seçimi ----
    private static readonly IReadOnlyList<string> _allModels = ModelCatalog.ModelNames();
    private static readonly string[] ClassicFive = { "Zero-order", "First-order", "Higuchi", "Hixson-Crowell", "Korsmeyer-Peppas" };
    private bool _modelPickerOpen;

    /// <summary>Seçim AnalysisState'te yaşar; ilk açılışta hepsi seçili.</summary>
    private HashSet<string> SelectedModels =>
        State.KinetikModels ??= new HashSet<string>(_allModels, StringComparer.OrdinalIgnoreCase);

    private void ToggleModel(string name, bool on)
    {
        if (on) SelectedModels.Add(name); else SelectedModels.Remove(name);
    }
    private void SelectAllModels() { SelectedModels.Clear(); SelectedModels.UnionWith(_allModels); }
    private void SelectNoModels() => SelectedModels.Clear();
    private void SelectClassicModels() { SelectedModels.Clear(); SelectedModels.UnionWith(ClassicFive); }

    /// <summary>Sıralanan + mekanizma modelleri (tahmin tablosu hepsini gösterir).</summary>
    private IEnumerable<ModelFit> AllFits =>
        _result is null ? Enumerable.Empty<ModelFit>() : _result.Fits.Concat(_result.MechanismFits);

    // Sütun başlıkları arayüz dilinden gelir; L enjeksiyonu alan başlatıcısından sonra
    // geldiği için liste OnInitialized'da kurulur.
    private List<HandsontableGrid.ColumnConfig> _columns = [];

    protected override void OnInitialized()
    {
        string T(string key) => L[key].Value;
        _columns =
        [
            new() { Title = T("Zaman"), Data = "Time",  Type = "numeric", Width = 70, NumericFormat = "0.###" },
            new() { Title = T("Tekrar") + " 1", Data = "Rep1", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 2", Data = "Rep2", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 3", Data = "Rep3", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 4", Data = "Rep4", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 5", Data = "Rep5", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Tekrar") + " 6", Data = "Rep6", Type = "numeric", Width = 70, NumericFormat = "0.00" },
            new() { Title = T("Ortalama"), Data = "Mean", Type = "numeric", Width = 80, NumericFormat = "0.00" },
            new() { Title = T("StdSapma"), Data = "StdDev", Type = "numeric", Width = 80, NumericFormat = "0.00" },
        ];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsChartDraw)
        {
            _needsChartDraw = false;
            await DrawChartAsync();
        }
    }

    private async Task ComputeAsync()
    {
        if (_hotInvitro is null) return;

        if (SelectedModels.Count == 0)
        {
            _uyarilar = [L["En az bir model seçin."].Value];
            _dataCount = 0;
            _result = null; _selectedFit = null; _estimateTable = null;
            _timeData = _releaseData = _predictedData = null;
            _showChart = false;
            _modelPickerOpen = true;
            StateHasChanged();
            return;
        }

        var dataObj = await _hotInvitro.GetDataAsync();
        var data = ConvertJsonToArray(dataObj);

        // Tekrarı olan satırların Ortalama/StdSapma sütunlarını doldur (elle girilmiş
        // ortalamalar ezilmez; okuyucu o satırları listeye almaz).
        var stats = KineticInputReader.ReplicateStats(data);
        var changes = stats
            .Select(x => new object[] { x.Row, KineticInputReader.MeanColumn, Math.Round(x.Mean, 2) })
            .Concat(stats.Select(x => new object[] { x.Row, KineticInputReader.StdDevColumn, Math.Round(x.StdDev, 2) }))
            .ToList();
        if (changes.Count > 0) await _hotInvitro.SetCellsAsync(changes);

        var profile = KineticInputReader.Read(data);
        _uyarilar = profile.Warnings;
        _dataCount = profile.T.Length;

        if (_dataCount == 0)
        {
            // Eski sonuçlar ekranda kalmasın: yoksa "0 veri noktası" başlığının altında
            // önceki analizin tablosu durur ve kullanıcı onu yeni sonuç sanır.
            _result = null;
            _selectedFit = null;
            _estimateTable = null;
            _timeData = _releaseData = _predictedData = null;
            _showChart = false;
            StateHasChanged();
            return;
        }

        var t = profile.T;
        var f = profile.F;
        _timeData = t;
        _releaseData = f;

        // Tüm fit mantığı artık EgePharmTech.Core.Dissolution içinde:
        // doğrusal tohum → F-uzayında nonlineer rafinasyon → GoF → AIC sıralaması.
        _result = KineticEngine.FitAll(t, f, Options);

        _selectedFit = _result.Fits.Count > 0 ? _result.Fits[0] : _result.MechanismFits.FirstOrDefault();
        _predictedData = _selectedFit is not null ? Evaluate(_selectedFit, t) : null;

        BuildEstimateTable();

        _showChart = true;
        _needsChartDraw = true;
        StateHasChanged();
    }

    private void BuildEstimateTable()
    {
        if (_result is null || _timeData is null || _releaseData is null) return;

        var fits = AllFits.ToArray();
        _estimateTable = new List<EstimateRow>(_timeData.Length);
        for (int i = 0; i < _timeData.Length; i++)
        {
            var estimates = fits.Select(fit => Clamp(fit.Predict(_timeData[i]))).ToArray();
            _estimateTable.Add(new EstimateRow(_timeData[i], _releaseData[i], estimates));
        }
    }

    private async Task SelectModelAsync(ModelFit fit)
    {
        if (_timeData is null) return;
        _selectedFit = fit;
        _predictedData = Evaluate(fit, _timeData);
        StateHasChanged();
        await DrawChartAsync();
    }

    /// <summary>Fit edilmiş modeli gözlem zamanlarında değerlendirir (grafik için).</summary>
    private static double[] Evaluate(ModelFit fit, double[] times)
        => times.Select(t => Clamp(fit.Predict(t))).ToArray();

    private static double Clamp(double v)
    {
        if (double.IsNaN(v) || double.IsInfinity(v)) return 0;
        return Math.Clamp(v, 0, 100);
    }

    private async Task DrawChartAsync()
    {
        if (_timeData is null || _releaseData is null || _timeData.Length == 0) return;
        try
        {
            // Zamanlar metne çevrilmeden gönderilir: uygulama kültürü tr-TR olduğu
            // için "0,5" gibi bir metin tarayıcıda parseFloat ile 0'a düşer ve
            // noktalar x ekseninde yanlış yere oturur (bkz. F1F2 aynı tuzağı
            // InvariantCulture ile aşıyor). Sayı olarak geçince biçimlendirme
            // yuvarlaması da kaybolmaz.
            var labels = new
            {
                observed = L["Gözlenen Salım (%)"].Value,
                predictedPrefix = L["Tahmini"].Value,
                predicted = L["Tahmini Salım (%)"].Value,
                x = L["Zaman"].Value,
                y = L["Salım (%)"].Value
            };
            await JS.InvokeVoidAsync("chartHelper.createReleaseChart",
                "releaseChart", _timeData, _releaseData,
                L["Zaman - Salım Profili"].Value, _predictedData, _selectedFit?.ModelName, labels);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chart error: {ex.Message}");
        }
    }

    // ---------------- veri okuma yardımcıları ----------------
    // Satır okuma / ortalama / kalan-format çevrimi EgePharmTech.Core.Dissolution.KineticInputReader'a
    // taşındı (T-testindeki TTestInputReader ile aynı yaklaşım): test edilebilir ve
    // sayfa ne yaptığını uyarı listesiyle bildiriyor.

    private static object?[][] ConvertJsonToArray(object? data)
    {
        if (data is null) return [];
        if (data is JsonElement jsonElement && jsonElement.ValueKind == JsonValueKind.Array)
        {
            var rows = new List<object?[]>();
            foreach (var row in jsonElement.EnumerateArray())
            {
                if (row.ValueKind != JsonValueKind.Array) continue;
                var cells = new List<object?>();
                foreach (var cell in row.EnumerateArray())
                {
                    cells.Add(cell.ValueKind switch
                    {
                        JsonValueKind.Number => cell.GetDouble(),
                        JsonValueKind.String => cell.GetString(),
                        JsonValueKind.Null => null,
                        _ => cell.ToString()
                    });
                }
                rows.Add(cells.ToArray());
            }
            return rows.ToArray();
        }
        return [];
    }
}

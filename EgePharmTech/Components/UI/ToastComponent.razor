@inject IJSRuntime JSRuntime

@* ToastComponent *@
<div class="toast-container position-fixed top-0 end-0 pt-5 pe-3">
    <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
        <div class="toast-header">
            <strong class="me-auto" style="color:@Type;">@Title</strong>
            <small>@now.ToString("dd.MM.yyyy HH: mm:ss")</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @Message 
        </div>
    </div>
</div>

<script>
    function showToast() {
    var toastElement = document.getElementById('liveToast');
    var toast = new bootstrap.Toast(toastElement);
    toast.show();
    }
</script>


@code {
    private string Title { get; set; }
    private string Message { get; set; }
    private string Type { get; set; }
    DateTime now;

    public async void ShowSuccess(string message)
    {
        Title = "Başarılı işlem";
        Message = message;
        Type = "green";
        now = DateTime.Now;
        StateHasChanged();
        await ShowToast();
    }
    public async void ShowFailed(string message)
    {
        Title = "Başarısız işlem";
        Message = message;
        Type = "red";
        now = DateTime.Now;
        StateHasChanged();
        await ShowToast();

    }

    private async Task ShowToast() =>
            // Razor'daki JavaScript fonksiyonunu çağır
            await JSRuntime.InvokeVoidAsync("showToast");
}



